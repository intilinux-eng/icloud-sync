[Unit]
Description=iCloud Drive sync (icloud-sync)
Documentation=https://github.com/intilinux-eng/icloud-sync

[Service]
Type=simple
ExecStart=/usr/bin/icloud-sync watch
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=30
# SIGTERM only to the daemon, which stops rclone cleanly (state is saved)
KillMode=mixed
TimeoutStopSec=100
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
