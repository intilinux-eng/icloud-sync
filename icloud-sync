class Engine:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.rclone = need_rclone(cfg)
        self.local = Path(os.path.expanduser(cfg["local"])).absolute()
        self.remote = cfg["remote"]
        self.child: subprocess.Popen | None = None
        self.interrupted = False
        self.new_skips = 0
        self.dir_seen: dict[str, str] = {}  # cartella remota -> ID (con etag) all'ultima esplorazione
        self.map_stale = True
        self.root_items: list[dict] | None = None

    # -- processi

    def run(self, args: list[str], timeout: float | None = 120, **kw) -> subprocess.CompletedProcess:
        return subprocess.run([self.rclone, *args], capture_output=True, text=True, timeout=timeout, **kw)

    def interrupt(self) -> None:
        """Arresto pulito: rclone bisync salva lo stato quando riceve SIGINT."""
        if self.child and self.child.poll() is None:
            self.interrupted = True
            try:
                self.child.send_signal(signal.SIGINT)
            except ProcessLookupError:
                pass

    def online(self) -> bool:
        host = self.cfg["connectivity_host"]
        if not host:
            return True
        try:
            socket.create_connection((host, 443), timeout=6).close()
            return True
        except OSError:
            return False

    def probe(self) -> tuple[bool, str]:
        """Elenco veloce del primo livello: dice se il remote risponde davvero."""
        try:
            p = self.run(["lsf", self.remote, "--max-depth", "1"], timeout=120)
        except subprocess.TimeoutExpired:
            return False, "timeout"
        return p.returncode == 0, last_error(p.stderr) or p.stderr.strip()[-300:]

    def fingerprint(self) -> str | None:
        """Impronta della radice remota con una sola richiesta.

        iCloud riporta per ogni cartella di primo livello dimensione ricorsiva ed etag: cambiano quando
        un file viene aggiunto, modificato o eliminato a qualunque profondità. None = non disponibile.
        """
        try:
            p = self.run(["lsjson", self.remote, "--max-depth", "1", *QUICK], timeout=40)
            if p.returncode != 0:
                return None
            self.root_items = json.loads(p.stdout)
            items = sorted((e.get("Name"), e.get("IsDir"), e.get("Size"), e.get("ModTime"), e.get("ID"))
                           for e in self.root_items)
        except (subprocess.TimeoutExpired, ValueError, OSError):
            return None
        return hashlib.sha1(json.dumps(items).encode()).hexdigest()

    def refresh_dir_map(self) -> bool:
        """Memorizza l'etag di ogni cartella remota (un elenco delle sole cartelle, ~8s a riposo).

        L'ID che iCloud dà a una cartella termina con un etag che cambia quando cambia qualcosa al suo
        interno, a qualunque profondità: confrontandolo con quello memorizzato si sa dove scendere.
        """
        try:
            p = self.run(["lsjson", self.remote, "-R", "--dirs-only", "--no-mimetype", "--no-modtime"], timeout=300)
            dirs = json.loads(p.stdout) if p.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError, OSError):
            dirs = None
        if dirs is None:
            return False
        self.dir_seen = {d["Path"]: d["ID"] for d in dirs if d.get("ID")}
        self.map_stale = False
        return True

    def known_remote(self, side: str = "path2") -> tuple[set[str], dict[str, int]] | None:
        """Stato all'ultima sync, letto dagli elenchi di bisync (path2 = iCloud, path1 = cartella locale):
        file noti e dimensione di ogni cartella."""
        work = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "rclone/bisync"
        key = str(self.local).replace("/", "_") + ".."
        cands = [f for f in work.glob(f"*.{side}.lst") if key in f.name]
        if len(cands) != 1:
            return None
        files: set[str] = set()
        sizes: dict[str, int] = {}
        for line in cands[0].read_text(errors="replace").splitlines():
            m = LST_RE.match(line)
            if not m or m.group(1) != "-":
                continue
            try:
                name = json.loads(f'"{m.group(3)}"')
            except ValueError:
                name = m.group(3)
            files.add(name)
            parts = name.split("/")[:-1]
            for i in range(1, len(parts) + 1):
                d = "/".join(parts[:i])
                sizes[d] = sizes.get(d, 0) + int(m.group(2))
        return files, sizes

    def fast_pull(self) -> list[str]:
        """Corsia veloce: scarica subito i file NUOVI comparsi su iCloud, senza elencare tutto il Drive.

        Parte dalla radice appena letta dal controllo leggero e scende solo nelle cartelle il cui etag è
        cambiato. Scarica soltanto file che bisync non conosceva e che non esistono in locale: non
        sovrascrive e non elimina mai nulla. Modifiche ed eliminazioni restano al giro completo che segue.
        """
        if not self.dir_seen or self.root_items is None:
            return []  # serve prima la mappa degli etag (refresh_dir_map)
        with LOCK_FILE.open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return []
            known = self.known_remote()
            if not known or not self.local.is_dir():
                return []
            files, _sizes = known
            excluded = exclude_matcher(self.cfg["exclude"])
            skipped = load_state().get("skipped", {})

            def is_skipped(rel: str) -> bool:
                return any(rel == k.rstrip("/") or (k.endswith("/") and f"{rel}/".startswith(k)) for k in skipped)

            new: list[str] = []
            todo: list[tuple[str, str]] = []
            seen_now: dict[str, str] = {}

            def scan(d: str, items: list[dict]) -> None:
                for e in items:
                    name = e.get("Name", "")
                    rel = f"{d}/{name}" if d else name
                    if not name or excluded(name) or is_skipped(rel):
                        continue
                    if e.get("IsDir"):
                        ident = e.get("ID") or ""
                        if not ident or self.dir_seen.get(rel) != ident:
                            todo.append((rel, ident))  # etag cambiato (o cartella nuova): si scende
                    elif rel not in files and not (self.local / rel).exists():
                        new.append(rel)

            scan("", self.root_items)
            budget = FAST_PULL_REQUESTS
            while todo and budget > 0:
                d, ident = todo.pop(0)
                budget -= 1
                try:
                    p = self.run(["lsjson", remote_join(self.remote, d), *QUICK], timeout=40)
                    items = json.loads(p.stdout) if p.returncode == 0 else None
                except (subprocess.TimeoutExpired, ValueError, OSError):
                    items = None
                if items is None:
                    return []
                scan(d, items)
                if ident:
                    seen_now[d] = ident
            if todo:
                self.map_stale = True  # troppe cartelle cambiate: lascia fare al giro completo, poi rifai la mappa
                return []
            self.dir_seen.update(seen_now)
            if not new or len(new) > FAST_PULL_FILES:
                return []
            listfile = STATE_DIR / "fast-pull.txt"
            listfile.write_text("\n".join(new) + "\n")
            self.child = subprocess.Popen(
                [self.rclone, "copy", self.remote, str(self.local), "--files-from-raw", str(listfile),
                 "--ignore-existing", "--no-traverse", "--transfers", str(self.cfg["transfers"]), "--retries", "1",
                 "--log-file", str(STATE_DIR / "fast-pull.log"), "--log-level", "ERROR"],
                stdin=subprocess.DEVNULL, start_new_session=True)
            try:
                self.child.wait()
            finally:
                self.child = None
            return [rel for rel in new if (self.local / rel).exists()]

    # -- preparazione

    def empty_dirs_supported(self, st: dict) -> bool:
        feats = st.setdefault("features", {})
        if self.remote not in feats:
            p = self.run(["backend", "features", self.remote])
            if p.returncode != 0:
                raise RcloneFailure(p.returncode, p.stderr)
            feats[self.remote] = bool(json.loads(p.stdout).get("Features", {}).get("CanHaveEmptyDirectories"))
        return feats[self.remote]

    def signature(self, filters: str, empty_dirs: bool) -> str:
        blob = json.dumps([str(self.local), self.remote, filters, empty_dirs, self.cfg["check_access"]])
        return hashlib.sha256(blob.encode()).hexdigest()[:16]

    def restore_local_check_file(self) -> bool:
        """Rimette in locale il file di controllo se è stato eliminato per sbaglio (ha l'aria di un file inutile).

        Lo fa solo se la cartella locale è chiaramente quella vera: almeno metà dei file dell'ultima sync
        esiste ancora. Una cartella vuota o non montata resta quindi bloccata, come deve.
        """
        target = self.local / CHECK_FILE
        if target.exists():
            return False
        known = self.known_remote("path1")
        others = [f for f in known[0] if f != CHECK_FILE] if known else []
        if not others or CHECK_FILE not in known[0]:
            return False
        if sum((self.local / f).exists() for f in others) * 2 < len(others):
            return False
        return self.run(["copyto", remote_join(self.remote, CHECK_FILE), str(target)]).returncode == 0 and target.exists()

    def migrate_check_file(self) -> bool:
        """Converte il vecchio file di controllo visibile in quello nascosto.

        Solo se il vecchio esiste in locale e iCloud ha almeno uno dei due: cioè quando la protezione
        attuale è soddisfatta. I due lati cambiano allo stesso modo, quindi bisync non vede conflitti.
        """
        old, new = self.local / OLD_CHECK_FILE, self.local / CHECK_FILE
        if new.exists() or not old.is_file():
            return False
        p = self.run(["lsf", self.remote, "--max-depth", "1", "--files-only",
                      "--include", f"/{OLD_CHECK_FILE}", "--include", f"/{CHECK_FILE}"])
        if p.returncode != 0:
            return False
        on_remote = set(p.stdout.splitlines())
        if CHECK_FILE in on_remote:  # già convertito da un altro PC
            if self.run(["copyto", remote_join(self.remote, CHECK_FILE), str(new)]).returncode != 0:
                return False
        elif OLD_CHECK_FILE in on_remote:
            new.write_text(CHECK_TEXT)
            if self.run(["copyto", str(new), remote_join(self.remote, CHECK_FILE)]).returncode != 0:
                new.unlink(missing_ok=True)
                return False
        else:
            return False  # nessun file di controllo su iCloud: situazione anomala, resta bloccato
        if OLD_CHECK_FILE in on_remote:
            self.run(["deletefile", remote_join(self.remote, OLD_CHECK_FILE)])
        old.unlink(missing_ok=True)
        return True

    def ensure_check_files(self) -> None:
        """Crea il file di controllo dove manca. Chiamato SOLO su richiesta esplicita o al primo avvio."""
        lf = self.local / CHECK_FILE
        rf = remote_join(self.remote, CHECK_FILE)
        p = self.run(["lsf", rf])
        on_remote = p.returncode == 0 and p.stdout.strip() != ""
        if on_remote and not lf.exists():
            p = self.run(["copyto", rf, str(lf)])
        elif not on_remote:
            if not lf.exists():
                lf.write_text(CHECK_TEXT)
            p = self.run(["copyto", str(lf), rf])
        if p.returncode != 0 and not (on_remote and lf.exists()):
            raise RcloneFailure(p.returncode, p.stderr)

    # -- esecuzione

    def bisync(self, *, resync: str | None, dry_run: bool, force: bool, interactive: bool, empty_dirs: bool) -> tuple[int, str]:
        c = self.cfg
        cmd = [
            self.rclone, "bisync", str(self.local), self.remote,
            "--resilient", "--recover", "--max-lock", "2m",
            "--compare", "size,modtime",
            "--conflict-resolve", c["conflict_resolve"], "--conflict-loser", "num",
            "--max-delete", str(c["max_delete"]),
            "--filters-file", str(FILTERS_FILE),
            "--transfers", str(c["transfers"]), "--checkers", str(c["checkers"]),
            "--skip-links",
            "--log-file", str(RUN_LOG), "-v",
        ]
        if c["check_access"]:
            cmd += ["--check-access", "--check-filename", CHECK_FILE]
        if empty_dirs:
            cmd.append("--create-empty-src-dirs")
        if resync:
            cmd += ["--resync", "--resync-mode", resync]
        if dry_run:
            cmd.append("--dry-run")
        if force:
            cmd.append("--force")
        cmd += ["--progress"] if interactive else ["--stats", "0"]
        cmd += c["extra_flags"]

        RUN_LOG.write_text("")
        # Sessione propria: Ctrl+C / SIGTERM arrivano solo a noi, che inoltriamo UN solo SIGINT.
        self.child = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
        try:
            rc = self.child.wait()
        except KeyboardInterrupt:
            say("\nInterruzione: attendo che rclone salvi lo stato …")
            self.interrupt()
            self.child.wait()
            raise
        finally:
            self.child = None
        text = RUN_LOG.read_text(errors="replace")
        if rc != 0:
            shutil.copyfile(RUN_LOG, ERR_LOG)
        elif not dry_run and any(parse_counts(text).values()):
            shutil.copyfile(RUN_LOG, CHANGE_LOG)
        return rc, text

    def classify(self, rc: int, text: str) -> Result:
        counts = parse_counts(text)
        if rc == 0:
            return Result("ok", summarize(counts), counts)
        low = text.lower()
        err = last_error(text) or f"rclone è uscito con codice {rc}"
        if AUTH_RE.search(text):
            return Result("auth", err)
        if "too many deletes" in low:
            return Result("deletes", err)
        if ACCESS_RE.search(text):
            return Result("access", err)
        if EMPTY_RE.search(text):
            return Result("empty", err)
        if LOST_STATE_RE.search(text):
            return Result("resync-needed", err)
        return Result("error", err)

    def attempt(self, st: dict, *, resync: str | None, dry_run: bool, force: bool, interactive: bool, manual: bool) -> Result:
        if not self.local.is_dir():
            if st.get("baseline"):
                return Result("error", f"cartella locale non trovata: {self.local} (disco non montato?)")
            self.local.mkdir(parents=True)
        if not self.online():
            return Result("offline", "nessuna connessione")

        ver = ".".join(map(str, rclone_version(self.rclone)))
        if st.get("rclone_version") != ver:
            if st.get("skipped") and st.get("rclone_version"):
                log(f"rclone aggiornato a {ver}: riprovo i {len(st['skipped'])} elementi esclusi in precedenza")
                st["skipped"] = {}
            st["rclone_version"] = ver

        opts = dict(dry_run=dry_run, force=force, interactive=interactive, manual=manual)
        for _ in range(3):
            res, text = self.run_once(st, resync=resync, **opts)
            if res.status not in ("error", "resync-needed") or dry_run:
                break
            new = {p: why for p, why in find_unsyncable(text).items() if p not in st.get("skipped", {})}
            if not new:
                break
            st.setdefault("skipped", {}).update(new)
            self.new_skips += len(new)
            for path, why in sorted(new.items()):
                log(f"Escluso dalla sincronizzazione: {path} — {why}")
            # le esclusioni cambiano i filtri: il giro successivo riallinea da solo
        return self.refine(res)

    def run_once(self, st: dict, *, resync: str | None, dry_run: bool, force: bool, interactive: bool,
                 manual: bool) -> tuple[Result, str]:
        ftext = filters_text(self.cfg["exclude"], st.get("skipped"))
        if not FILTERS_FILE.exists() or FILTERS_FILE.read_text() != ftext:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            FILTERS_FILE.write_text(ftext)
        try:
            empty_dirs = self.empty_dirs_supported(st)
            sig = self.signature(ftext, empty_dirs)
            first = st.get("baseline") != sig
            if first and not resync:
                log("Prima sincronizzazione (o configurazione cambiata): allineo i due lati senza eliminare nulla")
                resync = "newer"
            if self.cfg["check_access"] and not dry_run and self.migrate_check_file():
                log(f"File di controllo convertito: {OLD_CHECK_FILE} → {CHECK_FILE} (nascosto)")
            if resync and (manual or first) and self.cfg["check_access"]:
                self.ensure_check_files()
            elif self.cfg["check_access"] and not dry_run and self.restore_local_check_file():
                log(f"{CHECK_FILE} mancava nella cartella locale: ripristinato da iCloud")
        except RcloneFailure as e:
            return self.classify(e.rc, e.text), e.text
        except subprocess.TimeoutExpired:
            return Result("remote", "timeout nel contattare il remote"), ""

        opts = dict(dry_run=dry_run, force=force, interactive=interactive, empty_dirs=empty_dirs)
        rc, text = self.bisync(resync=resync, **opts)
        if self.interrupted:
            # Arresto richiesto: non è un errore, la prossima esecuzione riprende da dove serve (--recover)
            return Result("stopped", "interrotta su richiesta"), text
        res = self.classify(rc, text)

        if res.status == "deletes" and not force and not dry_run:
            # La soglia in percentuale ha senso sui grandi numeri: poche eliminazioni sono uso normale.
            wanted = [int(n) for n in DELETES_RE.findall(text)]
            if wanted and max(wanted) <= self.cfg["max_delete_min_files"]:
                rc, text = self.bisync(resync=resync, **{**opts, "force": True})
                res = self.classify(rc, text)

        cooled = time.time() - st.get("last_auto_resync", 0) > AUTO_RESYNC_COOLDOWN
        unsyncable = bool(find_unsyncable(text))
        if (res.status == "resync-needed" and not resync and not dry_run and not unsyncable
                and self.cfg["auto_resync"] and cooled):
            log(f"Stato bisync non valido ({res.message}): ricostruisco con --resync (nessun file viene eliminato)")
            resync = "newer"
            rc, text = self.bisync(resync=resync, **opts)
            res = self.classify(rc, text)
            if res.ok:  # il limite di frequenza serve contro i cicli di ricostruzione, non contro i tentativi falliti
                st["last_auto_resync"] = time.time()

        if res.ok and resync and not dry_run:
            st["baseline"] = sig
        return res, text

    def refine(self, res: Result) -> Result:
        """Un errore generico può essere il login scaduto con un testo che non riconosciamo: chiedilo al remote."""
        if res.status == "error":
            ok, perr = self.probe()
            if not ok:
                return Result("auth" if AUTH_RE.search(perr) else "remote", perr or res.message)
        return res

    def sync(self, *, resync: str | None = None, dry_run: bool = False, force: bool = False,
             interactive: bool = False, manual: bool = False) -> Result:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOCK_FILE.open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                if not manual:
                    return Result("busy", "un'altra sincronizzazione è in corso")
                say("Un'altra sincronizzazione è in corso: attendo che finisca …")
                fcntl.flock(lock, fcntl.LOCK_EX)
            st = load_state()
            prev = st.get("status")
            t0 = time.time()
            with activity():
                res = self.attempt(st, resync=resync, dry_run=dry_run, force=force, interactive=interactive, manual=manual)
            if dry_run or res.status == "stopped":
                return res
            st.update(status=res.status, message=res.message, last_attempt=t0, last_duration=round(time.time() - t0, 1))
            if res.ok:
                st.update(last_success=time.time(), last_counts=res.counts)
            self.announce(prev, res, st)
            save_state(st)

        took = f"{time.time() - t0:.0f}s"
        if res.ok:
            if any(res.counts.values()) or prev != "ok":
                log(f"OK in {took}: {res.message}")
        elif res.status != prev or manual:
            log(f"{STATUS_TEXT.get(res.status, res.status)} — {res.message}")
        return res

    def announce(self, prev: str | None, res: Result, st: dict) -> None:
        """Notifiche desktop. Un errore generico è quasi sempre passeggero (es. una cartella eliminata
        mentre veniva letta): viene riprovato in silenzio e segnalato solo se si ripete."""
        if self.new_skips:
            notify(self.cfg, "iCloud Drive: elementi esclusi",
                   f"{self.new_skips} elementi non scaricabili da iCloud sono stati esclusi dalla sincronizzazione.\n"
                   f"Elenco:  {APP} skipped")
            self.new_skips = 0
        if res.ok:
            st["error_streak"] = 0
            if st.pop("alerted", False):
                notify(self.cfg, "iCloud Drive", "Sincronizzazione ripristinata.")
            if res.counts.get("conflicts"):
                notify(self.cfg, "iCloud Drive: conflitto",
                       f"{res.counts['conflicts']} file modificati su entrambi i lati. "
                       "Entrambe le versioni sono state conservate (cerca «.conflict»).")
        elif res.status not in ("offline", "busy"):
            st["error_streak"] = st.get("error_streak", 0) + 1 if res.status == "error" else 0
            persistent = res.status != "error" or st["error_streak"] >= 2
            if persistent and (res.status != prev or not st.get("alerted")):
                st["alerted"] = True
                notify(self.cfg, f"iCloud Drive: {STATUS_TEXT[res.status].lstrip('✗ ')}",
                       f"{res.message}\n{STATUS_HINT.get(res.status, '')}", urgent=True)


class RcloneFailure(Exception):
    def __init__(self, rc: int, text: str):
        super().__init__(text)
        self.rc, self.text = rc, text


def last_error(text: str) -> str:
    for line in reversed(text.splitlines()):
        if re.search(r"\b(ERROR|CRITICAL)\b|Failed to", line):
            line = LOG_PREFIX_RE.sub("", line)
            line = re.sub(r"\x1b\[[0-9;]*m", "", line)
            return re.sub(r"^(ERROR|CRITICAL|NOTICE)\s*:\s*", "", line).strip()[:400]
    return ""


def parse_counts(text: str) -> dict:
    conflicts = len(re.findall(r"New or changed in both paths", text)) - len(re.findall(r"Files are equal! Skipping", text))
    return {
        "copied": len(re.findall(r": Copied \(", text)),
        "deleted": len(re.findall(r": Deleted$", text, re.M)),
        "moved": len(re.findall(r": (?:Moved|Renamed) \(", text)),
        "conflicts": max(0, conflicts),
    }


def summarize(c: dict) -> str:
    parts = [f"{c[k]} {label}" for k, label in
             (("copied", "copiati"), ("deleted", "eliminati"), ("moved", "rinominati"), ("conflicts", "conflitti")) if c.get(k)]
    return ", ".join(parts) or "nessuna modifica"


# ---------------------------------------------------------------- inotify

IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO, IN_CREATE, IN_DELETE = 0x8, 0x40, 0x80, 0x100, 0x200
IN_Q_OVERFLOW, IN_IGNORED, IN_ISDIR = 0x4000, 0x8000, 0x40000000
IN_ONLYDIR, IN_DONT_FOLLOW = 0x01000000, 0x02000000
WATCH_MASK = IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_ONLYDIR | IN_DONT_FOLLOW
EVENT_HDR = struct.Struct("iIII")


class Watcher:
    """Sorveglianza ricorsiva della cartella locale con inotify (via ctypes, nessuna dipendenza)."""

    def __init__(self, root: Path, excluded):
        self.root, self.excluded = str(root), excluded
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 fallita")
        self.paths: dict[int, str] = {}
        self.limit_hit = False
        self.add_tree(self.root)

    def add(self, path: str) -> None:
        wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), WATCH_MASK)
        if wd >= 0:
            self.paths[wd] = path
        elif ctypes.get_errno() == errno.ENOSPC:
            self.limit_hit = True

    def add_tree(self, top: str) -> None:
        self.add(top)
        for dirpath, dirnames, _ in os.walk(top):
            dirnames[:] = [d for d in dirnames if not self.excluded(d)]
            for d in dirnames:
                self.add(os.path.join(dirpath, d))

    def poll(self) -> bool:
        """Svuota la coda degli eventi; True se è cambiato qualcosa che ci interessa."""
        changed = rescan = False
        while True:
            try:
                buf = os.read(self.fd, 65536)
            except BlockingIOError:
                break
            off = 0
            while off < len(buf):
                wd, mask, _cookie, ln = EVENT_HDR.unpack_from(buf, off)
                off += EVENT_HDR.size
                name = buf[off:off + ln].rstrip(b"\0").decode(errors="surrogateescape")
                off += ln
                if mask & IN_Q_OVERFLOW:
                    changed = rescan = True
                elif mask & IN_IGNORED:
                    self.paths.pop(wd, None)
                elif name and not self.excluded(name):
                    changed = True
                    parent = self.paths.get(wd)
                    if mask & IN_ISDIR and mask & (IN_CREATE | IN_MOVED_TO) and parent:
                        self.add_tree(os.path.join(parent, name))
        if rescan:
            self.add_tree(self.root)
        return changed


# ---------------------------------------------------------------- demone

def backoff(status: str, failures: int) -> int:
    if status == "offline":
        return 30
    if status == "busy":
        return 15
    if status in ("auth", "deletes", "access", "empty", "resync-needed"):
        return 900  # serve l'utente: i comandi login/sync/resync ci svegliano subito
    return min(60 * 2 ** (failures - 1), 900)


def cmd_watch(cfg: dict, _args) -> int:
    eng = Engine(cfg)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))
    flags = {"stop": False, "now": False}
    rfd, wfd = os.pipe()
    os.set_blocking(rfd, False)
    os.set_blocking(wfd, False)
    signal.set_wakeup_fd(wfd)

    def on_stop(*_):
        flags["stop"] = True
        eng.interrupt()

    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)
    signal.signal(signal.SIGUSR1, lambda *_: flags.__setitem__("now", True))

    eng.local.mkdir(parents=True, exist_ok=True)
    watcher = None
    try:
        watcher = Watcher(eng.local, exclude_matcher(cfg["exclude"]))
        if watcher.limit_hit:
            log("Attenzione: limite di watch inotify raggiunto; alcune cartelle sono coperte solo dal controllo periodico "
                "(aumenta fs.inotify.max_user_watches)")
    except OSError as e:
        log(f"inotify non disponibile ({e}): uso solo il controllo periodico")
    probe_every = cfg["remote_check_interval"]
    log(f"Avviato: {eng.local} ⇄ {eng.remote} — {len(watcher.paths) if watcher else 0} cartelle sorvegliate, "
        + (f"controllo leggero di iCloud ogni {probe_every}s, " if probe_every else "")
        + f"controllo completo ogni {cfg['poll_interval']}s")

    INF = float("inf")
    next_poll = not_before = 0.0
    next_probe, probe_delay = INF, probe_every
    synced_fp = None  # impronta remota a cui corrisponde l'ultima sync senza modifiche
    idle_hits = 0     # sync consecutive chieste dal controllo leggero ma rivelatesi vuote
    first_evt = last_evt = None
    failures = 0
    while not flags["stop"]:
        now = time.monotonic()
        evt_due = min(last_evt + cfg["debounce"], first_evt + cfg["max_wait"]) if first_evt is not None else INF
        sync_due = max(not_before, min(next_poll, evt_due))
        deadline = min(sync_due, max(not_before, next_probe)) if probe_every else sync_due
        if not flags["now"] and now < deadline:
            fds = [rfd] + ([watcher.fd] if watcher else [])
            select.select(fds, [], [], min(deadline - now, 3600))
            try:
                os.read(rfd, 4096)
            except BlockingIOError:
                pass
            if watcher and watcher.poll():
                last_evt = time.monotonic()
                first_evt = first_evt if first_evt is not None else last_evt
            continue

        by_probe = False
        if not flags["now"] and now < sync_due:
            # Solo controllo leggero: se la radice remota è identica all'ultima sync, non c'è nulla da fare.
            fp_before = eng.fingerprint()
            next_probe = time.monotonic() + probe_delay
            if fp_before is None or fp_before == synced_fp:
                if fp_before is not None:
                    idle_hits, probe_delay = 0, probe_every
                continue
            by_probe = True
            with activity():
                pulled = eng.fast_pull()
            if flags["stop"]:
                break
            if pulled:
                names = ", ".join(os.path.basename(f) for f in pulled[:3]) + (f" e altri {len(pulled) - 3}" if len(pulled) > 3 else "")
                log(f"Da iCloud: {len(pulled)} nuovi file ({names})")
                if cfg["notify_downloads"]:
                    notify(cfg, "Nuovo da iCloud Drive", names)
                if watcher:
                    watcher.poll()  # gli eventi dei file appena scaricati non richiedono un altro giro
        else:
            fp_before = eng.fingerprint() if probe_every else None

        flags["now"] = False
        res = eng.sync()
        if flags["stop"]:
            break
        dirty = bool(watcher and watcher.poll())  # modifiche avvenute durante la sync
        now = time.monotonic()
        if res.ok:
            failures, not_before, next_poll = 0, 0.0, now + cfg["poll_interval"]
            first_evt = last_evt = now if dirty else None
            changed = any(res.counts.values())
            # Dopo una sync che ha spostato file l'impronta include anche le nostre modifiche: la si
            # considera sconosciuta, così il prossimo controllo fa un giro di conferma (vuoto) e la fissa.
            synced_fp = None if changed else fp_before
            if probe_every and not changed and eng.map_stale and not dirty:
                eng.refresh_dir_map()  # a riposo: subito dopo una modifica iCloud elenca molto più lentamente
            if changed:
                idle_hits, probe_delay = 0, probe_every
            elif by_probe:
                idle_hits += 1
                if idle_hits >= 3:  # impronta instabile: dirada i controlli invece di sincronizzare a vuoto
                    probe_delay = min(probe_delay * 2, cfg["poll_interval"])
            next_probe = now + probe_delay if probe_every else INF
            login_reminder(cfg)
        else:
            failures += 1
            not_before = next_poll = next_probe = now + backoff(res.status, failures)
            if dirty and first_evt is None:
                first_evt = last_evt = now

    log("Arrestato")
    PID_FILE.unlink(missing_ok=True)
    return 0


def login_reminder(cfg: dict) -> None:
    st = load_state()
    last = st.get("last_login")
    if not last:
        return
    left = TRUST_DAYS - (time.time() - last) / 86400
    today = time.strftime("%Y-%m-%d")
    if left <= 4 and st.get("last_reminder") != today:
        st["last_reminder"] = today
        save_state(st)
        notify(cfg, "iCloud Drive: login in scadenza",
               f"Il login Apple scade tra circa {max(0, int(left))} giorni.\nRinnovalo con:  {APP} login")


def pid_of(pidfile: Path) -> int | None:
    """PID scritto in un file, solo se appartiene davvero a un nostro processo ancora vivo."""
    try:
        pid = int(pidfile.read_text())
        if APP.encode() in Path(f"/proc/{pid}/cmdline").read_bytes():
            return pid
    except (OSError, ValueError):
        pass
    return None


def poke_daemon() -> bool:
    """Chiede al demone di sincronizzare subito."""
    pid = pid_of(PID_FILE)
    if pid is None:
        return False
    try:
        os.kill(pid, signal.SIGUSR1)
    except OSError:
        return False
    return True


# ---------------------------------------------------------------- comandi

def finish(res: Result) -> int:
    say(f"{STATUS_TEXT.get(res.status, res.status)} — {res.message}")
    if not res.ok:
        if STATUS_HINT.get(res.status):
            say(STATUS_HINT[res.status])
        return 1
    return 0


def finish_dry_run(res: Result) -> int:
    """Anteprima: elenca le operazioni che rclone avrebbe eseguito."""
    if not res.ok:
        return finish(res)
    planned = [LOG_PREFIX_RE.sub("", l).replace("NOTICE: ", "").replace(" as --dry-run is set", "")
               for l in RUN_LOG.read_text(errors="replace").splitlines() if "--dry-run is set" in l]
    say("\n".join(f"  {l}" for l in planned) if planned else "Nessuna modifica da fare.")
    say("(anteprima: non è stato modificato nulla)")
    return 0


def cmd_sync(cfg: dict, args) -> int:
    res = Engine(cfg).sync(dry_run=args.dry_run, force=args.force, interactive=sys.stdout.isatty(), manual=True)
    return finish_dry_run(res) if args.dry_run else finish(res)


def cmd_resync(cfg: dict, args) -> int:
    mode = {"newer": "newer", "local": "path1", "icloud": "path2"}[args.prefer]
    say("Riallineo i due lati: i file presenti da una sola parte vengono copiati dall'altra, nulla viene eliminato.")
    res = Engine(cfg).sync(resync=mode, dry_run=args.dry_run, interactive=sys.stdout.isatty(), manual=True)
    return finish_dry_run(res) if args.dry_run else finish(res)


def cmd_login(cfg: dict, args) -> int:
    rclone = need_rclone(cfg)
    name = remote_name(cfg["remote"])
    if not name:
        sys.exit(f"«{cfg['remote']}» non è un remote rclone: niente login da fare.")
    remotes = subprocess.run([rclone, "listremotes"], capture_output=True, text=True).stdout.split()
    exists = f"{name}:" in remotes
    if not exists or args.new_password or args.reset:
        conf = rclone_conf_path(rclone)
        values: dict[str, str | None] = {}
        if args.reset:
            values.update(cookies=None, trust_token=None)
        if not exists or args.new_password:
            apple_id = getattr(args, "apple_id", None) or ask("Apple ID (email)")
            say("Password dell'Apple ID (quella normale, non una «password per app»).")
            say("Viene salvata solo nella configurazione locale di rclone, offuscata.")
            pw = getpass.getpass("Password: ")
            p = subprocess.run([rclone, "obscure", "-"], input=pw, capture_output=True, text=True)
            if p.returncode != 0 or not p.stdout.strip():
                sys.exit(f"rclone obscure fallito: {p.stderr.strip()}")
            values.update(type="iclouddrive", apple_id=apple_id, password=p.stdout.strip())
        try:
            rclone_conf_set(conf, name, values)
        except RuntimeError as e:
            sys.exit(f"Non posso scrivere {conf}: {e}.\nCrea il remote a mano con `rclone config` "
                     f"(nome «{name}», tipo «iclouddrive») e rilancia.")
    say("\nOra Apple chiederà il codice di verifica a 2 fattori (arriva sui tuoi dispositivi Apple).")
    say("Con la Protezione avanzata dei dati attiva: abilita prima «Accedi ai dati iCloud sul web» su iPhone.\n")
    if subprocess.call([rclone, "config", "reconnect", f"{name}:"]) != 0:
        say(f"\n✗ Login non riuscito. Riprova con:  {APP} login --reset   (azzera cookie e token salvati)")
        return 1
    p = subprocess.run([rclone, "lsf", cfg["remote"], "--max-depth", "1"], capture_output=True, text=True)
    if p.returncode != 0:
        say(f"\n✗ Login completato ma iCloud Drive non risponde: {last_error(p.stderr) or p.stderr.strip()[-300:]}")
        return 1
    st = load_state()
    st.update(last_login=time.time(), last_reminder=None)
    save_state(st)
    say(f"\n✓ Login riuscito: {len(p.stdout.splitlines())} elementi nella radice di iCloud Drive. "
        f"Valido circa {TRUST_DAYS} giorni.")
    poke_daemon()
    return 0


def systemctl(*args: str, quiet: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=quiet, text=True)


def is_system_install() -> bool:
    return Path(__file__).resolve().parent in (Path("/usr/bin"), Path("/usr/local/bin"))


def installed_script() -> Path:
    """Percorso stabile del programma: quello di sistema (.deb) oppure una copia in ~/.local/bin."""
    me = Path(__file__).resolve()
    if is_system_install():
        return me
    target = BIN_DIR / APP
    if me != target.resolve():
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(me, target)
        target.chmod(0o755)
        say(f"✓ Installato {target}")
    return target


def has_tray_support() -> bool:
    return importlib.util.find_spec("PyQt6") is not None


def start_tray(script: Path) -> None:
    if pid_of(TRAY_LOCK) is None and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        subprocess.Popen([sys.executable, str(script), "tray"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_enable(cfg: dict, _args) -> int:
    script = installed_script()
    if is_system_install() and SYSTEM_UNIT.exists():
        UNIT_PATH.unlink(missing_ok=True)  # una vecchia unità personale nasconderebbe quella del pacchetto
    else:
        UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
        UNIT_PATH.write_text(UNIT_TEMPLATE.format(homepage=HOMEPAGE, exec=f'"{sys.executable}" "{script}"'))
    systemctl("daemon-reload")
    rc = systemctl("enable", "--now", UNIT_NAME).returncode
    if rc != 0:
        return rc
    systemctl("restart", UNIT_NAME)
    say("✓ Servizio attivo: parte da solo a ogni accesso.")
    if has_tray_support():
        AUTOSTART_PATH.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_PATH.write_text(
            "[Desktop Entry]\nType=Application\nName=iCloud Drive Sync\n"
            f'Exec="{sys.executable}" "{script}" tray\nIcon={APP}\nTerminal=false\n'
            "X-GNOME-Autostart-enabled=true\nX-KDE-autostart-phase=2\n")
        start_tray(script)
        say("✓ Icona nel vassoio di sistema attiva.")
    else:
        say("Per l'icona nel vassoio installa PyQt6 (sudo apt install python3-pyqt6) e ripeti il comando.")
    if not is_system_install() and str(BIN_DIR) not in os.environ.get("PATH", "").split(":"):
        say(f"Nota: {BIN_DIR} non è nel PATH; aggiungilo o usa il percorso completo.")
    return 0


def cmd_disable(_cfg: dict, _args) -> int:
    systemctl("disable", "--now", UNIT_NAME)
    UNIT_PATH.unlink(missing_ok=True)
    systemctl("daemon-reload")
    AUTOSTART_PATH.unlink(missing_ok=True)
    tray = pid_of(TRAY_LOCK)
    if tray:
        with contextlib.suppress(OSError):
            os.kill(tray, signal.SIGTERM)
    say("Servizio e icona disattivati. Configurazione e file restano dove sono.")
    return 0


# ---------------------------------------------------------------- icona nel vassoio

def is_syncing() -> bool:
    try:
        return Path(f"/proc/{int(ACTIVITY_FILE.read_text())}").exists()
    except (OSError, ValueError):
        return False


def tray_state() -> tuple[str, str, str]:
    """(tipo, testo, suggerimento) per l'icona: ok | sync | error | offline | stopped | unknown."""
    st = load_state()
    status = st.get("status")
    if is_syncing():
        return "sync", "Sincronizzazione in corso…", ""
    if pid_of(PID_FILE) is None:
        return "stopped", "Sincronizzazione automatica ferma", f"Avvia con:  {APP} enable"
    if status == "ok":
        return "ok", f"Sincronizzato {ago(st.get('last_success'))}", ""
    if status == "offline":
        return "offline", "Offline: riprendo appena torna la rete", ""
    if status in (None, "busy", "stopped"):
        return "unknown", "In attesa della prima sincronizzazione", ""
    if status == "error" and st.get("error_streak", 0) < 2:
        return "offline", "Problema temporaneo: riprovo tra poco", ""
    text = STATUS_TEXT.get(status, status).lstrip("✗… ")
    return "error", text[:1].upper() + text[1:], STATUS_HINT.get(status, "")


def tray_pixmap(QtCore, QtGui, kind: str, size: int = 64):
    """Disegna l'icona (nuvola + bollino di stato) senza dipendere da temi o file esterni."""
    Qt = QtCore.Qt
    pm = QtGui.QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QtGui.QPainter(pm)
    p.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)
    p.scale(size / 64, size / 64)
    cloud = QtGui.QPainterPath()
    cloud.setFillRule(Qt.FillRule.WindingFill)
    cloud.addEllipse(QtCore.QRectF(3, 24, 26, 26))
    cloud.addEllipse(QtCore.QRectF(15, 9, 32, 32))
    cloud.addEllipse(QtCore.QRectF(37, 22, 24, 24))
    cloud.addRoundedRect(QtCore.QRectF(12, 30, 42, 20), 10, 10)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QtGui.QColor("#3daee9" if kind in ("ok", "sync", "error") else "#9aa3ad"))
    p.drawPath(cloud.simplified())
    badge = {"ok": "#27ae60", "sync": "#1d6fa5", "error": "#da4453", "stopped": "#6b7680", "offline": "#6b7680"}.get(kind)
    if badge:
        c = QtCore.QPointF(47, 47)
        p.setCompositionMode(QtGui.QPainter.CompositionMode.CompositionMode_Clear)
        p.drawEllipse(c, 16.5, 16.5)  # stacco trasparente tra nuvola e bollino
        p.setCompositionMode(QtGui.QPainter.CompositionMode.CompositionMode_SourceOver)
        p.setBrush(QtGui.QColor(badge))
        p.drawEllipse(c, 14, 14)
        pen = QtGui.QPen(QtGui.QColor("white"), 4, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        if kind == "ok":
            p.drawPolyline(QtGui.QPolygonF([QtCore.QPointF(40, 47.5), QtCore.QPointF(45, 52.5), QtCore.QPointF(54, 42)]))
        elif kind == "sync":
            p.drawArc(QtCore.QRectF(40, 40, 14, 14), 60 * 16, 250 * 16)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QtGui.QColor("white"))
            p.drawPolygon(QtGui.QPolygonF([QtCore.QPointF(49, 36), QtCore.QPointF(56.5, 41), QtCore.QPointF(48.5, 45)]))
        elif kind == "error":
            p.drawLine(QtCore.QPointF(47, 39.5), QtCore.QPointF(47, 48.5))
            p.drawPoint(QtCore.QPointF(47, 55))
        elif kind == "stopped":
            p.drawLine(QtCore.QPointF(43, 41.5), QtCore.QPointF(43, 52.5))
            p.drawLine(QtCore.QPointF(51, 41.5), QtCore.QPointF(51, 52.5))
        else:  # offline
            p.drawLine(QtCore.QPointF(40.5, 47), QtCore.QPointF(53.5, 47))
    p.end()
    return pm


def cmd_tray(cfg: dict, _args) -> int:
    try:
        from PyQt6 import QtCore, QtGui, QtWidgets
    except ImportError:
        sys.exit("Per l'icona nel vassoio serve PyQt6:  sudo apt install python3-pyqt6")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = TRAY_LOCK.open("a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        say("L'icona nel vassoio è già attiva.")
        return 0
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()

    app = QtWidgets.QApplication([APP])
    app.setApplicationName(APP)
    app.setApplicationDisplayName("iCloud Drive")
    app.setDesktopFileName(APP)
    app.setQuitOnLastWindowClosed(False)
    local = Path(os.path.expanduser(cfg["local"])).absolute()
    script = Path(__file__).resolve()

    tray = QtWidgets.QSystemTrayIcon()
    menu = QtWidgets.QMenu()
    status_item = menu.addAction("")
    status_item.setEnabled(False)
    hint_item = menu.addAction("")
    hint_item.setEnabled(False)
    menu.addSeparator()
    open_item = menu.addAction(QtGui.QIcon.fromTheme("folder-open"), "Apri cartella iCloud Drive")
    sync_item = menu.addAction(QtGui.QIcon.fromTheme("view-refresh"), "Sincronizza ora")
    menu.addSeparator()
    quit_item = menu.addAction(QtGui.QIcon.fromTheme("application-exit"), "Chiudi icona")

    def open_folder() -> None:
        QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(str(local)))

    def sync_now() -> None:
        if not poke_daemon():  # servizio fermo: una sincronizzazione singola
            subprocess.Popen([sys.executable, str(script), "sync"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def on_click(reason) -> None:
        if reason == QtWidgets.QSystemTrayIcon.ActivationReason.Trigger:
            open_folder()

    open_item.triggered.connect(open_folder)
    sync_item.triggered.connect(sync_now)
    quit_item.triggered.connect(app.quit)
    tray.activated.connect(on_click)
    tray.setContextMenu(menu)

    icons: dict[str, object] = {}
    shown: list[object] = [None]

    def refresh() -> None:
        state = tray_state()
        if state == shown[0]:
            return
        shown[0] = state
        kind, text, hint = state
        if kind not in icons:
            icons[kind] = QtGui.QIcon(tray_pixmap(QtCore, QtGui, kind))
        tray.setIcon(icons[kind])
        tray.setToolTip(f"iCloud Drive — {text}")
        status_item.setText(text)
        hint_item.setText(hint)
        hint_item.setVisible(bool(hint))
        sync_item.setEnabled(kind != "sync")

    refresh()
    tray.show()
    timer = QtCore.QTimer()
    timer.timeout.connect(refresh)  # il timer fa anche girare l'interprete, così i segnali vengono serviti
    timer.start(2000)
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    rc = app.exec()
    tray.hide()
    return rc


def cmd_restart(_cfg: dict, _args) -> int:
