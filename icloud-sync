# ---------------------------------------------------------------- utilità

def say(msg: str = "") -> None:
    print(msg, flush=True)


def log(msg: str) -> None:
    """Riga su stdout (journal) e nel file di log persistente."""
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    say(line)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if LOG_FILE.exists() and LOG_FILE.stat().st_size > 5_000_000:
            LOG_FILE.replace(LOG_FILE.with_suffix(".log.1"))
        with LOG_FILE.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


@contextlib.contextmanager
def activity():
    """Segnala (all'icona nel vassoio) che una sincronizzazione è in corso."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        ACTIVITY_FILE.write_text(str(os.getpid()))
    except OSError:
        pass
    try:
        yield
    finally:
        ACTIVITY_FILE.unlink(missing_ok=True)


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=1))
    tmp.replace(STATE_FILE)


def ago(ts: float | None) -> str:
    if not ts:
        return "mai"
    d = max(0, time.time() - ts)
    if d < 90:
        return f"{int(d)} s fa"
    if d < 5400:
        return f"{int(d / 60)} min fa"
    if d < 172800:
        return f"{int(d / 3600)} h fa"
    return f"{int(d / 86400)} giorni fa"


def ask(prompt: str, default: str = "") -> str:
    ans = input(f"{prompt} [{default}]: " if default else f"{prompt}: ").strip()
    return ans or default


def confirm(prompt: str, default: bool = True) -> bool:
    ans = input(f"{prompt} [{'S/n' if default else 's/N'}]: ").strip().lower()
    return default if not ans else ans[0] in "sy"


def notify(cfg: dict, title: str, body: str, urgent: bool = False) -> None:
    if not cfg.get("notifications") or not shutil.which("notify-send"):
        return
    try:
        subprocess.run(
            ["notify-send", "-a", "iCloud Drive", "-i", "folder-cloud",
             "-u", "critical" if urgent else "normal", title, body],
            timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        pass


# ---------------------------------------------------------------- configurazione

def load_config(required: bool = True) -> dict:
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            user = tomllib.loads(CONFIG_FILE.read_text())
        except tomllib.TOMLDecodeError as e:
            sys.exit(f"Errore in {CONFIG_FILE}: {e}")
        for k, v in user.items():
            if k not in DEFAULTS:
                say(f"attenzione: opzione sconosciuta «{k}» in {CONFIG_FILE}")
            elif type(v) is not type(DEFAULTS[k]):
                sys.exit(f"Errore in {CONFIG_FILE}: «{k}» deve essere di tipo {type(DEFAULTS[k]).__name__}")
            else:
                cfg[k] = v
    elif required:
        sys.exit(f"Nessuna configurazione trovata. Esegui prima:  {APP} setup")
    return cfg


def write_config(cfg: dict) -> None:
    out = [f"# Configurazione di {APP}. Dopo una modifica: {APP} restart", ""]
    for k in DEFAULTS:
        out += [f"# {line}" if i == 0 else line for i, line in enumerate(CONFIG_HELP[k].split("\n"))]
        v = cfg[k]
        if isinstance(v, bool):
            out.append(f"{k} = {'true' if v else 'false'}")
        elif isinstance(v, list):
            out.append(f"{k} = [" + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + "]")
        elif isinstance(v, str):
            out.append(f"{k} = {json.dumps(v, ensure_ascii=False)}")
        else:
            out.append(f"{k} = {v}")
        out.append("")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text("\n".join(out))


def exclude_matcher(patterns: list[str]):
    pats = [p.rstrip("/") for p in patterns]
    return lambda name: any(fnmatch.fnmatchcase(name, p) for p in pats)


def filters_text(patterns: list[str], skipped: dict[str, str] | None = None) -> str:
    lines = [f"# generato da {APP} da config.toml: non modificare a mano"]
    for p in patterns:
        lines.append(f"- {p}**" if p.endswith("/") else f"- {p}")
    if skipped:
        lines.append(f"# esclusi automaticamente perché iCloud/rclone non li fa scaricare ({APP} skipped)")
        for path in sorted(skipped):
            rule = "/" + re.sub(r"([*?\[\]{}\\])", r"\\\1", path)
            lines.append(f"- {rule}**" if path.endswith("/") else f"- {rule}")
    return "\n".join(lines) + "\n"


# Errori permanenti per singolo file: riprovare non serve, bloccherebbero ogni sincronizzazione.
UNSYNCABLE = [
    # cartelle condivise: rclone le elenca ma non ottiene l'URL di download -> si esclude la cartella
    (re.compile(r"ERROR : (.+?): Failed to copy: failed to open source object: RootURL not set"), True,
     "cartella condivisa: rclone non riesce a scaricarla"),
    # documenti iWork (Keynote/Pages/Numbers): iCloud dichiara una dimensione diversa dal file servito
    (re.compile(r"ERROR : (.+?)\.[0-9a-f]{8}\.partial: corrupted on transfer: sizes differ"), False,
     "dimensione incoerente su iCloud (tipico dei documenti iWork)"),
]


def find_unsyncable(text: str) -> dict[str, str]:
    found = {}
    for rx, whole_dir, why in UNSYNCABLE:
        for m in rx.finditer(text):
            path = m.group(1)
            if whole_dir and "/" in path:
                path = path.rsplit("/", 1)[0] + "/"
            found[path] = why
    return found


# ---------------------------------------------------------------- rclone

def find_rclone(cfg: dict) -> str | None:
    for cand in (cfg.get("rclone_path"), shutil.which("rclone"), str(BIN_DIR / "rclone")):
        if cand and os.access(os.path.expanduser(cand), os.X_OK):
            return os.path.expanduser(cand)
    return None


def rclone_version(rclone: str) -> tuple[int, ...]:
    out = subprocess.run([rclone, "version"], capture_output=True, text=True).stdout
    m = re.search(r"rclone v(\d+)\.(\d+)(?:\.(\d+))?", out)
    return tuple(int(x or 0) for x in m.groups()) if m else (0,)


def need_rclone(cfg: dict) -> str:
    rclone = find_rclone(cfg)
    if not rclone:
        sys.exit(f"rclone non trovato. Installa con:  {APP} install-rclone   (oppure: sudo apt install rclone)")
    ver = rclone_version(rclone)
    if ver[:2] < MIN_RCLONE:
        sys.exit(f"rclone {'.'.join(map(str, ver))} è troppo vecchio: serve >= 1.69 per iCloud Drive.\n"
                 f"Aggiorna con:  {APP} install-rclone")
    return rclone


def install_rclone() -> str:
    """Scarica il binario ufficiale in ~/.local/bin verificandone lo SHA-256."""
    arch = {"x86_64": "amd64", "aarch64": "arm64", "armv7l": "arm-v7", "i686": "386"}.get(platform.machine())
    if not arch:
        sys.exit(f"Architettura {platform.machine()} non gestita: installa rclone da https://rclone.org/downloads/")

    def fetch(url: str) -> bytes:
        # downloads.rclone.org rifiuta (403) lo User-Agent predefinito di urllib
        req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
        with urllib.request.urlopen(req, timeout=120) as r:
            return r.read()

    ver = fetch("https://downloads.rclone.org/version.txt").decode().split()[-1]
    name = f"rclone-{ver}-linux-{arch}.zip"
    base = f"https://downloads.rclone.org/{ver}/"
    say(f"Scarico {name} da downloads.rclone.org …")
    data = fetch(base + name)
    sums = fetch(base + "SHA256SUMS").decode()
    expected = next((l.split()[0] for l in sums.splitlines() if l.strip().endswith(name)), None)
    actual = hashlib.sha256(data).hexdigest()
    if expected != actual:
        sys.exit(f"Checksum NON valido per {name} (atteso {expected}, ottenuto {actual}): installazione annullata.")
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        member = next(n for n in z.namelist() if n.endswith("/rclone"))
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        target = BIN_DIR / "rclone"
        tmp = target.with_suffix(".new")
        tmp.write_bytes(z.read(member))
        tmp.chmod(0o755)
        tmp.replace(target)
    say(f"✓ rclone {ver} installato in {target} (checksum verificato)")
    return str(target)


def rclone_conf_path(rclone: str) -> Path:
    out = subprocess.run([rclone, "config", "file"], capture_output=True, text=True).stdout
    return Path(out.strip().splitlines()[-1])


def rclone_conf_set(path: Path, section: str, values: dict[str, str | None]) -> None:
    """Imposta (o rimuove, se None) chiavi in una sezione di rclone.conf senza toccare il resto."""
    text = path.read_text() if path.exists() else ""
    if text.startswith("# Encrypted rclone configuration"):
        raise RuntimeError("la configurazione di rclone è cifrata")
    lines = text.splitlines()
    try:
        start = next(i for i, l in enumerate(lines) if l.strip() == f"[{section}]")
    except StopIteration:
        lines += ["", f"[{section}]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    body = [l for l in lines[start + 1:end] if l.strip()]
    todo = dict(values)
    new_body = []
    for l in body:
        key = l.split("=", 1)[0].strip()
        if key in todo:
            v = todo.pop(key)
            if v is not None:
                new_body.append(f"{key} = {v}")
        else:
            new_body.append(l)
    new_body += [f"{k} = {v}" for k, v in todo.items() if v is not None]
    lines[start + 1:end] = new_body + [""]
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".icloud-sync.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines).strip("\n") + "\n")
    tmp.replace(path)


def remote_name(remote: str) -> str | None:
    if ":" in remote and not remote.startswith(("/", ".", "~")):
        return remote.split(":", 1)[0]
    return None


def remote_join(remote: str, name: str) -> str:
    if remote.endswith(":") or remote.endswith("/"):
        return remote + name
    return f"{remote}/{name}"


