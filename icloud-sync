def cmd_doctor(cfg: dict, _args) -> int:
    bad = 0

    def check(ok: bool, label: str, detail: str = "") -> None:
        nonlocal bad
        bad += not ok
        say(f"  {'✓' if ok else '✗'} {label}" + (f" — {detail}" if detail else ""))

    rclone = find_rclone(cfg)
    ver = rclone_version(rclone) if rclone else (0,)
    check(bool(rclone) and ver[:2] >= MIN_RCLONE, "rclone",
          f"{rclone} v{'.'.join(map(str, ver))}" if rclone else f"mancante → {APP} install-rclone")
    if not rclone or ver[:2] < MIN_RCLONE:
        return 1
    eng = Engine(cfg)
    name = remote_name(eng.remote)
    if name:
        remotes = eng.run(["listremotes"]).stdout.split()
        check(f"{name}:" in remotes, f"remote «{name}» configurato", "" if f"{name}:" in remotes else f"→ {APP} login")
    check(eng.online(), "rete", cfg["connectivity_host"] or "controllo disattivato")
    t0 = time.time()
    ok, err = eng.probe()
    check(ok, "iCloud Drive risponde", f"{time.time() - t0:.1f}s" if ok else f"{err} → {APP} login")
    check(eng.local.is_dir(), "cartella locale", str(eng.local))
    if cfg["check_access"] and ok:
        lf = (eng.local / CHECK_FILE).exists()
        p = eng.run(["lsf", remote_join(eng.remote, CHECK_FILE)])
        rf = p.returncode == 0 and bool(p.stdout.strip())
        check(lf and rf, f"file di controllo {CHECK_FILE}",
              "presente su entrambi i lati" if lf and rf else f"locale: {'sì' if lf else 'no'}, iCloud: {'sì' if rf else 'no'} → {APP} resync")
    if eng.local.is_dir():
        ndirs = sum(1 for _ in os.walk(eng.local))
        try:
            limit = int(Path("/proc/sys/fs/inotify/max_user_watches").read_text())
        except (OSError, ValueError):
            limit = 0
        check(not limit or ndirs < limit * 0.8, "inotify", f"{ndirs} cartelle, limite {limit}")
    svc = service_state()
    check(svc == "attivo", "servizio", svc if svc == "attivo" else f"{svc} → {APP} enable")
    st = load_state()
    check(st.get("status") == "ok", "ultima sincronizzazione",
          f"{STATUS_TEXT.get(st.get('status'), 'mai eseguita')} ({ago(st.get('last_attempt'))})")
    return 1 if bad else 0


def cmd_setup(_cfg, _args) -> int:
    say(f"=== {APP}: configurazione guidata ===")
    say("Software libero (licenza MIT), fornito senza alcuna garanzia: tieni un backup dei file importanti.\n")
    cfg = load_config(required=False)

    rclone = find_rclone(cfg)
    if not rclone or rclone_version(rclone)[:2] < MIN_RCLONE:
        say("rclone (>= 1.69) non è installato: è il motore che parla con iCloud.")
        if not confirm("Scarico il binario ufficiale da rclone.org in ~/.local/bin (con verifica del checksum)?"):
            say(f"Installalo (es. sudo apt install rclone) e rilancia:  {APP} setup")
            return 1
        install_rclone()

    if not CONFIG_FILE.exists():
        name = ask("Nome del remote rclone", "icloud")
        cfg["remote"] = f"{name}:"
        cfg["local"] = ask("Cartella locale", DEFAULTS["local"])
    write_config(cfg)
    say(f"✓ Configurazione: {CONFIG_FILE}\n")

    ns = argparse.Namespace(new_password=False, reset=False, apple_id=None)
    eng = Engine(cfg)
    ok = False
    if remote_name(cfg["remote"]) and f"{remote_name(cfg['remote'])}:" in eng.run(["listremotes"]).stdout.split():
        ok, _ = eng.probe()
    if remote_name(cfg["remote"]) and not ok:
        if cmd_login(cfg, ns) != 0:
            return 1

    say("\nPrima sincronizzazione: unisce i due lati senza eliminare nulla; a parità di nome vince il file più recente.")
    say("Può richiedere tempo se iCloud Drive contiene molti file.\n")
    res = eng.sync(interactive=True, manual=True)
    if finish(res) != 0:
        say(f"\nRisolvi il problema e rilancia:  {APP} setup")
        return 1
    say("")
    if shutil.which("systemctl") and confirm("Attivo la sincronizzazione automatica in background?"):
        cmd_enable(cfg, None)
    say(f"\nFatto. Comandi utili:  {APP} status  ·  {APP} sync  ·  {APP} log  ·  {APP} doctor")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog=APP, description="Sincronizzazione bidirezionale di iCloud Drive su Linux (motore: rclone bisync).",
        epilog=f"Software libero con licenza MIT, fornito SENZA ALCUNA GARANZIA. Progetto indipendente, non affiliato ad Apple. {HOMEPAGE}")
    ap.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = ap.add_subparsers(dest="cmd", metavar="comando")

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_, description=help_)
        p.set_defaults(fn=fn)
        return p

    add("setup", cmd_setup, "configurazione guidata: rclone, login Apple, prima sync, servizio")
    add("status", cmd_status, "mostra lo stato della sincronizzazione").add_argument("--json", action="store_true")
    p = add("sync", cmd_sync, "sincronizza adesso")
    p.add_argument("--dry-run", action="store_true", help="mostra cosa farebbe senza modificare nulla")
    p.add_argument("--force", action="store_true", help="consenti anche un numero elevato di eliminazioni")
    p = add("resync", cmd_resync, "riallinea i due lati da zero (non elimina nulla)")
    p.add_argument("--prefer", choices=["newer", "local", "icloud"], default="newer", help="chi vince se un file differisce (default: il più recente)")
    p.add_argument("--dry-run", action="store_true")
    p = add("login", cmd_login, "(ri)autentica l'Apple ID: serve circa ogni 30 giorni")
    p.add_argument("--new-password", action="store_true", help="reinserisci Apple ID e password")
    p.add_argument("--reset", action="store_true", help="azzera cookie e token salvati prima di riprovare")
    add("enable", cmd_enable, "avvia il servizio in background e l'icona nel vassoio, a ogni accesso")
    add("disable", cmd_disable, "ferma servizio e icona")
    add("restart", cmd_restart, "riavvia il servizio (dopo aver cambiato la configurazione)")
    add("watch", cmd_watch, "esegue il demone in primo piano (usato dal servizio)")
    add("tray", cmd_tray, "icona nel vassoio di sistema: stato, apri cartella, sincronizza ora")
    p = add("log", cmd_log, "mostra le ultime righe del log")
    p.add_argument("-n", "--lines", type=int, default=40)
    p.add_argument("--error", action="store_true", help="log completo di rclone dell'ultima sync fallita")
    p = add("skipped", cmd_skipped, "elenca gli elementi che iCloud non lascia scaricare")
    p.add_argument("--retry", action="store_true", help="rimuovi le esclusioni e riprova")
    add("doctor", cmd_doctor, "diagnostica completa")
    add("install-rclone", cmd_install_rclone, "installa/aggiorna rclone in ~/.local/bin")

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        return 0
    cfg = None if args.cmd in ("setup", "install-rclone") else load_config()
    try:
        rc = args.fn(cfg, args)
    except KeyboardInterrupt:
        say("\nInterrotto.")
        return 130
    if rc == 0 and args.cmd in ("sync", "resync") and not args.dry_run:
        poke_daemon()
    return rc


if __name__ == "__main__":
    sys.exit(main())
