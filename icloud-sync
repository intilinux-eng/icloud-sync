# ---------------------------------------------------------------- utilità

def say(msg: str = "") -> None:
    print(msg, flush=True)


def log(msg: str) -> None:
    """Riga su stdout (journal) e nel file di log persistente."""
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    say(line)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if LOG_FILE.exists() and LOG_FILE.stat().st_size > 5_000_000:
            LOG_FILE.replace(LOG_FILE.with_suffix(".log.1"))
        with LOG_FILE.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


@contextlib.contextmanager
def activity():
    """Segnala (all'icona nel vassoio) che una sincronizzazione è in corso."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        ACTIVITY_FILE.write_text(str(os.getpid()))
    except OSError:
        pass
    try:
        yield
    finally:
        ACTIVITY_FILE.unlink(missing_ok=True)


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=1))
    tmp.replace(STATE_FILE)


def ago(ts: float | None) -> str:
    if not ts:
        return _('never')
    d = max(0, time.time() - ts)
    if d < 90:
        return _('{v1} s ago').format(v1=int(d))
    if d < 5400:
        return _('{v1} min ago').format(v1=int(d / 60))
    if d < 172800:
        return _('{v1} h ago').format(v1=int(d / 3600))
    return _('{v1} days ago').format(v1=int(d / 86400))


def ask(prompt: str, default: str = "") -> str:
    ans = input(f"{prompt} [{default}]: " if default else f"{prompt}: ").strip()
    return ans or default


def confirm(prompt: str, default: bool = True) -> bool:
    ans = input(f"{prompt} [{_('Y/n') if default else _('y/N')}]: ").strip().lower()
    return default if not ans else ans[0] in "sy"


def notify(cfg: dict, title: str, body: str, urgent: bool = False,
           actions: list[tuple[str, str, str]] | None = None) -> None:
    """Notifica desktop. actions = [(etichetta del pulsante, verbo, argomento)], vedi run_action()."""
    if not cfg.get("notifications") or not shutil.which("notify-send"):
        return
    try:
        if actions and shutil.which("gdbus"):
            # Un pulsante richiede che qualcuno aspetti la risposta: lo fa un processo a parte, mai il demone.
            spec = json.dumps({"title": title, "body": body, "urgent": urgent, "actions": actions})
            subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_notify", spec],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        else:
            plain_notification(title, body, urgent)
    except (OSError, subprocess.SubprocessError):
        pass


def plain_notification(title: str, body: str, urgent: bool) -> None:
    subprocess.run(["notify-send", "-a", "iCloud Drive", "-i", "folder-cloud",
                    "-u", "critical" if urgent else "normal", title, body],
                   timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_action(verb: str, arg: str) -> None:
    """Azioni dei pulsanti delle notifiche: login | show FILE | open CARTELLA."""
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if verb == "login":
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "login", "--gui"], **quiet)
    elif verb == "show" and shutil.which("gdbus") and Path(arg).exists():
        # Apre il gestore file con il file già selezionato (interfaccia standard org.freedesktop.FileManager1)
        rc = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.FileManager1",
                             "--object-path", "/org/freedesktop/FileManager1",
                             "--method", "org.freedesktop.FileManager1.ShowItems", f"['{Path(arg).as_uri()}']", ""],
                            capture_output=True, timeout=15).returncode
        if rc != 0:
            run_action("open", str(Path(arg).parent))
    elif verb in ("show", "open"):
        target = Path(arg) if verb == "open" else Path(arg).parent
        subprocess.Popen(["xdg-open", str(target)], **quiet)


def gvariant(text: str) -> str:
    """Stringa nel formato testuale di GVariant, per gli argomenti di gdbus."""
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n") + "'"


def cmd_notify_helper(_cfg, args) -> int:
    """Mostra una notifica con pulsanti, aspetta la scelta ed esegue l'azione (comando interno).

    Parla direttamente con il server delle notifiche (org.freedesktop.Notifications) tramite gdbus:
    `notify-send --action` su alcuni sistemi rifiuta i pulsanti anche quando il server li supporta.
    """
    spec = json.loads(args.spec)
    bus = ["--session", "--dest", "org.freedesktop.Notifications", "--object-path", "/org/freedesktop/Notifications"]
    buttons = ", ".join(f"{gvariant(str(i))}, {gvariant(label)}" for i, (label, _verb, _arg) in enumerate(spec["actions"]))
    hints = "{'urgency': <byte %d>, 'desktop-entry': <%s>}" % (2 if spec["urgent"] else 1, gvariant(APP))
    try:
        # Prima ci si mette in ascolto dei segnali, poi si invia: così la risposta non può andare persa.
        monitor = subprocess.Popen(["gdbus", "monitor", *bus], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        plain_notification(spec["title"], spec["body"], spec["urgent"])
        return 0
    deadline = time.monotonic() + NOTIFY_WAIT
    pending = b""

    def next_line() -> str | None:
        """Prossima riga del monitor, None a tempo scaduto o a monitor chiuso. Si legge il descrittore
        grezzo: con un flusso bufferizzato select() non vedrebbe le righe già lette in anticipo."""
        nonlocal pending
        while b"\n" not in pending:
            wait = deadline - time.monotonic()
            if wait <= 0 or not select.select([monitor.stdout], [], [], wait)[0]:
                return None
            chunk = os.read(monitor.stdout.fileno(), 4096)
            if not chunk:
                return None
            pending += chunk
        line, pending = pending.split(b"\n", 1)
        return line.decode(errors="replace")

    try:
        next_line()  # riga «Monitoring signals…»: l'ascolto è attivo
        sent = subprocess.run(
            ["gdbus", "call", *bus, "--method", "org.freedesktop.Notifications.Notify", gvariant("iCloud Drive"),
             "uint32 0", gvariant("folder-cloud"), gvariant(spec["title"]), gvariant(spec["body"]),
             f"[{buttons}]", hints, "int32 -1"], capture_output=True, text=True, timeout=15)
        found = re.search(r"uint32 (\d+)", sent.stdout)
        if sent.returncode != 0 or not found:
            plain_notification(spec["title"], spec["body"], spec["urgent"])
            return 0
        ident = found.group(1)
        while (line := next_line()) is not None:
            chosen = re.search(rf"ActionInvoked \(uint32 {ident}, '(\d+)'\)", line)
            if chosen and int(chosen.group(1)) < len(spec["actions"]):
                _label, verb, arg = spec["actions"][int(chosen.group(1))]
                run_action(verb, arg)
                break
            if re.search(rf"NotificationClosed \(uint32 {ident},", line):
                break
    except (OSError, subprocess.SubprocessError):
        pass
    finally:
        monitor.kill()
        monitor.wait()
        monitor.stdout.close()
    return 0


# ---------------------------------------------------------------- configurazione

def load_config(required: bool = True) -> dict:
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            user = tomllib.loads(CONFIG_FILE.read_text())
        except tomllib.TOMLDecodeError as e:
            sys.exit(_('Error in {config_file}: {e}').format(config_file=CONFIG_FILE, e=e))
        for k, v in user.items():
            if k not in DEFAULTS:
                say(_('warning: unknown option "{k}" in {config_file}').format(k=k, config_file=CONFIG_FILE))
            elif type(v) is not type(DEFAULTS[k]):
                sys.exit(_('Error in {config_file}: "{k}" must be of type {v1}').format(config_file=CONFIG_FILE, k=k, v1=type(DEFAULTS[k]).__name__))
            else:
                cfg[k] = v
    elif required:
        sys.exit(_('No configuration found. Run first:  {app} setup').format(app=APP))
    return cfg


def write_config(cfg: dict) -> None:
    out = [_('# Configuration of {app}. After a change: {app} restart').format(app=APP), ""]
    for k in DEFAULTS:
        out += [f"# {line}" if i == 0 else line for i, line in enumerate(_(CONFIG_HELP[k]).split("\n"))]
        v = cfg[k]
        if isinstance(v, bool):
            out.append(f"{k} = {'true' if v else 'false'}")
        elif isinstance(v, list):
            out.append(f"{k} = [" + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + "]")
        elif isinstance(v, str):
            out.append(f"{k} = {json.dumps(v, ensure_ascii=False)}")
        else:
            out.append(f"{k} = {v}")
        out.append("")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text("\n".join(out))


def exclude_matcher(patterns: list[str]):
    pats = [p.rstrip("/") for p in patterns]
    return lambda name: any(fnmatch.fnmatchcase(name, p) for p in pats)


def filters_text(patterns: list[str], skipped: dict[str, str] | None = None) -> str:
    # I due commenti restano in italiano in ogni lingua: bisync conserva l'impronta di questo file e
    # pretende un riallineamento completo se cambia anche un solo byte.
    lines = [f"# generato da {APP} da config.toml: non modificare a mano"]
    for p in patterns:
        lines.append(f"- {p}**" if p.endswith("/") else f"- {p}")
    if skipped:
        lines.append(f"# esclusi automaticamente perché iCloud/rclone non li fa scaricare ({APP} skipped)")
        for path in sorted(skipped):
            rule = "/" + re.sub(r"([*?\[\]{}\\])", r"\\\1", path)
            lines.append(f"- {rule}**" if path.endswith("/") else f"- {rule}")
    return "\n".join(lines) + "\n"


# Errori permanenti per singolo file: riprovare non serve, bloccherebbero ogni sincronizzazione.
UNSYNCABLE = [
    # cartelle condivise: rclone le elenca ma non ottiene l'URL di download -> si esclude la cartella
    (re.compile(r"ERROR : (.+?): Failed to copy: failed to open source object: RootURL not set"), True,
     N_('shared folder: rclone cannot download it')),
    # documenti iWork (Keynote/Pages/Numbers): iCloud dichiara una dimensione diversa dal file servito
    (re.compile(r"ERROR : (.+?)\.[0-9a-f]{8}\.partial: corrupted on transfer: sizes differ"), False,
     N_('inconsistent size on iCloud (typical of iWork documents)')),
]


def find_unsyncable(text: str) -> dict[str, str]:
    found = {}
    for rx, whole_dir, why in UNSYNCABLE:
        for m in rx.finditer(text):
            path = m.group(1)
            if whole_dir and "/" in path:
                path = path.rsplit("/", 1)[0] + "/"
            found[path] = why
    return found


# ---------------------------------------------------------------- rclone

def find_rclone(cfg: dict) -> str | None:
    for cand in (cfg.get("rclone_path"), shutil.which("rclone"), str(BIN_DIR / "rclone")):
        if cand and os.access(os.path.expanduser(cand), os.X_OK):
            return os.path.expanduser(cand)
    return None


def rclone_version(rclone: str) -> tuple[int, ...]:
    out = subprocess.run([rclone, "version"], capture_output=True, text=True).stdout
    m = re.search(r"rclone v(\d+)\.(\d+)(?:\.(\d+))?", out)
    return tuple(int(x or 0) for x in m.groups()) if m else (0,)


def need_rclone(cfg: dict) -> str:
    rclone = find_rclone(cfg)
    if not rclone:
        sys.exit(_('rclone not found. Install it with:  {app} install-rclone   (or: sudo apt install rclone)').format(app=APP))
    ver = rclone_version(rclone)
    if ver[:2] < MIN_RCLONE:
        sys.exit(_('rclone {v1} is too old: iCloud Drive needs >= 1.69.\nUpdate it with:  {app} install-rclone').format(v1='.'.join(map(str, ver)), app=APP))
    return rclone


def install_rclone() -> str:
    """Scarica il binario ufficiale in ~/.local/bin verificandone lo SHA-256."""
    arch = {"x86_64": "amd64", "aarch64": "arm64", "armv7l": "arm-v7", "i686": "386"}.get(platform.machine())
    if not arch:
        sys.exit(_('Architecture {v1} is not handled: install rclone from https://rclone.org/downloads/').format(v1=platform.machine()))

    def fetch(url: str) -> bytes:
        # downloads.rclone.org rifiuta (403) lo User-Agent predefinito di urllib
        req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
        with urllib.request.urlopen(req, timeout=120) as r:
            return r.read()

    ver = fetch("https://downloads.rclone.org/version.txt").decode().split()[-1]
    name = f"rclone-{ver}-linux-{arch}.zip"
    base = f"https://downloads.rclone.org/{ver}/"
    say(_('Downloading {name} from downloads.rclone.org …').format(name=name))
    data = fetch(base + name)
    sums = fetch(base + "SHA256SUMS").decode()
    expected = next((l.split()[0] for l in sums.splitlines() if l.strip().endswith(name)), None)
    actual = hashlib.sha256(data).hexdigest()
    if expected != actual:
        sys.exit(_('Checksum NOT valid for {name} (expected {expected}, got {actual}): installation cancelled.').format(name=name, expected=expected, actual=actual))
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        member = next(n for n in z.namelist() if n.endswith("/rclone"))
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        target = BIN_DIR / "rclone"
        tmp = target.with_suffix(".new")
        tmp.write_bytes(z.read(member))
        tmp.chmod(0o755)
        tmp.replace(target)
    say(_('✓ rclone {ver} installed in {target} (checksum verified)').format(ver=ver, target=target))
    return str(target)


def rclone_conf_path(rclone: str) -> Path:
    out = subprocess.run([rclone, "config", "file"], capture_output=True, text=True).stdout
    return Path(out.strip().splitlines()[-1])


def rclone_conf_set(path: Path, section: str, values: dict[str, str | None]) -> None:
    """Imposta (o rimuove, se None) chiavi in una sezione di rclone.conf senza toccare il resto."""
    text = path.read_text() if path.exists() else ""
    if text.startswith("# Encrypted rclone configuration"):
        raise RuntimeError(_('the rclone configuration is encrypted'))
    lines = text.splitlines()
    try:
        start = next(i for i, l in enumerate(lines) if l.strip() == f"[{section}]")
    except StopIteration:
        lines += ["", f"[{section}]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    body = [l for l in lines[start + 1:end] if l.strip()]
    todo = dict(values)
    new_body = []
    for l in body:
        key = l.split("=", 1)[0].strip()
        if key in todo:
            v = todo.pop(key)
            if v is not None:
                new_body.append(f"{key} = {v}")
        else:
            new_body.append(l)
    new_body += [f"{k} = {v}" for k, v in todo.items() if v is not None]
    lines[start + 1:end] = new_body + [""]
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".icloud-sync.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines).strip("\n") + "\n")
    tmp.replace(path)


def remote_name(remote: str) -> str | None:
    if ":" in remote and not remote.startswith(("/", ".", "~")):
        return remote.split(":", 1)[0]
    return None


def remote_join(remote: str, name: str) -> str:
    if remote.endswith(":") or remote.endswith("/"):
        return remote + name
    return f"{remote}/{name}"


# ---------------------------------------------------------------- motore di sync

class Result:
    def __init__(self, status: str, message: str = "", counts: dict | None = None):
        self.status, self.message, self.counts = status, message, counts or {}

    @property
    def ok(self) -> bool:
        return self.status == "ok"


