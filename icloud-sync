def systemctl(*args: str, quiet: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=quiet, text=True)


def is_system_install() -> bool:
    return Path(__file__).resolve().parent in (Path("/usr/bin"), Path("/usr/local/bin"))


def installed_script() -> Path:
    """Percorso stabile del programma: quello di sistema (.deb) oppure una copia in ~/.local/bin."""
    me = Path(__file__).resolve()
    if is_system_install():
        return me
    target = BIN_DIR / APP
    if me != target.resolve():
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(me, target)
        target.chmod(0o755)
        say(_('✓ Installed {target}').format(target=target))
    return target


def has_tray_support() -> bool:
    return importlib.util.find_spec("PyQt6") is not None


def start_tray(script: Path) -> None:
    if pid_of(TRAY_LOCK) is None and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        subprocess.Popen([sys.executable, str(script), "tray"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_enable(cfg: dict, _args) -> int:
    script = installed_script()
    if is_system_install() and SYSTEM_UNIT.exists():
        UNIT_PATH.unlink(missing_ok=True)  # una vecchia unità personale nasconderebbe quella del pacchetto
    else:
        UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
        UNIT_PATH.write_text(UNIT_TEMPLATE.format(homepage=HOMEPAGE, exec=f'"{sys.executable}" "{script}"'))
    systemctl("daemon-reload")
    rc = systemctl("enable", "--now", UNIT_NAME).returncode
    if rc != 0:
        return rc
    systemctl("restart", UNIT_NAME)
    say(_('✓ Service active: it starts by itself at every login.'))
    PAUSE_FILE.unlink(missing_ok=True)
    mark_folder(Path(os.path.expanduser(cfg["local"])).absolute(), True)
    if has_tray_support():
        AUTOSTART_PATH.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_PATH.write_text(
            "[Desktop Entry]\nType=Application\nName=iCloud Drive Sync\n"
            f'Exec="{sys.executable}" "{script}" tray\nIcon={APP}\nTerminal=false\n'
            "X-GNOME-Autostart-enabled=true\nX-KDE-autostart-phase=2\n")
        start_tray(script)
        say(_('✓ Tray icon active.'))
    else:
        say(_('For the tray icon install PyQt6 (sudo apt install python3-pyqt6) and run this command again.'))
    if not is_system_install() and str(BIN_DIR) not in os.environ.get("PATH", "").split(":"):
        say(_('Note: {bin_dir} is not in PATH; add it or use the full path.').format(bin_dir=BIN_DIR))
    return 0


def cmd_disable(cfg: dict, _args) -> int:
    mark_folder(Path(os.path.expanduser(cfg["local"])).absolute(), False)
    systemctl("disable", "--now", UNIT_NAME)
    UNIT_PATH.unlink(missing_ok=True)
    systemctl("daemon-reload")
    AUTOSTART_PATH.unlink(missing_ok=True)
    tray = pid_of(TRAY_LOCK)
    if tray:
        with contextlib.suppress(OSError):
            os.kill(tray, signal.SIGTERM)
    say(_('Service and tray icon disabled. Configuration and files stay where they are.'))
    return 0


def mark_folder(local: Path, on: bool) -> None:
    """Icona a nuvola sulla cartella sincronizzata in Dolphin, tramite il file .directory (che non viene sincronizzato)."""
    marker = local / ".directory"
    with contextlib.suppress(OSError):
        if on and local.is_dir() and not marker.exists():
            marker.write_text(DIRECTORY_FILE)
        elif not on and marker.exists() and marker.read_text() == DIRECTORY_FILE:
            marker.unlink()


