def _(text: str) -> str:
    """Traduce un messaggio. Il testo nel codice è l'inglese; i segnaposto {nome} restano gli stessi."""
    return IT.get(text, text) if LANGUAGE == "it" else text


def N_(text: str) -> str:
    """Segna come traducibile un testo definito a livello di modulo: lo traduce _() al momento dell'uso."""
    return text


