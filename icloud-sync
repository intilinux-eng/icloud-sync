def is_syncing() -> bool:
    try:
        return Path(f"/proc/{int(ACTIVITY_FILE.read_text())}").exists()
    except (OSError, ValueError):
        return False


def tray_state() -> tuple[str, str, str]:
    """(tipo, testo, suggerimento) per l'icona: ok | sync | error | offline | stopped | unknown."""
    st = load_state()
    status = st.get("status")
    if is_syncing():
        return "sync", _('Sync in progress…'), ""
    if pid_of(PID_FILE) is None:
        return "stopped", _('Automatic sync is stopped'), _('Start it with:  {app} enable').format(app=APP)
    if PAUSE_FILE.exists():
        return "stopped", _('Paused'), ""
    if status == "ok":
        return "ok", _('In sync, {v1}').format(v1=ago(st.get('last_success'))), ""
    if status == "offline":
        return "offline", _('Offline: resuming as soon as the network is back'), ""
    if status in (None, "busy", "stopped"):
        return "unknown", _('Waiting for the first sync'), ""
    if status == "error" and st.get("error_streak", 0) < 2:
        return "offline", _('Temporary problem: retrying shortly'), ""
    text = _(STATUS_TEXT.get(status, status)).lstrip("✗… ")
    return "error", text[:1].upper() + text[1:], _(STATUS_HINT.get(status, ""))


def tray_pixmap(QtCore, QtGui, kind: str, size: int = 64):
    """Disegna l'icona (nuvola + bollino di stato) senza dipendere da temi o file esterni."""
    Qt = QtCore.Qt
    pm = QtGui.QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QtGui.QPainter(pm)
    p.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)
    p.scale(size / 64, size / 64)
    cloud = QtGui.QPainterPath()
    cloud.setFillRule(Qt.FillRule.WindingFill)
    cloud.addEllipse(QtCore.QRectF(3, 24, 26, 26))
    cloud.addEllipse(QtCore.QRectF(15, 9, 32, 32))
    cloud.addEllipse(QtCore.QRectF(37, 22, 24, 24))
    cloud.addRoundedRect(QtCore.QRectF(12, 30, 42, 20), 10, 10)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QtGui.QColor("#3daee9" if kind in ("ok", "sync", "error") else "#9aa3ad"))
    p.drawPath(cloud.simplified())
    badge = {"ok": "#27ae60", "sync": "#1d6fa5", "error": "#da4453", "stopped": "#6b7680", "offline": "#6b7680"}.get(kind)
    if badge:
        c = QtCore.QPointF(47, 47)
        p.setCompositionMode(QtGui.QPainter.CompositionMode.CompositionMode_Clear)
        p.drawEllipse(c, 16.5, 16.5)  # stacco trasparente tra nuvola e bollino
        p.setCompositionMode(QtGui.QPainter.CompositionMode.CompositionMode_SourceOver)
        p.setBrush(QtGui.QColor(badge))
        p.drawEllipse(c, 14, 14)
        pen = QtGui.QPen(QtGui.QColor("white"), 4, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        if kind == "ok":
            p.drawPolyline(QtGui.QPolygonF([QtCore.QPointF(40, 47.5), QtCore.QPointF(45, 52.5), QtCore.QPointF(54, 42)]))
        elif kind == "sync":
            p.drawArc(QtCore.QRectF(40, 40, 14, 14), 60 * 16, 250 * 16)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QtGui.QColor("white"))
            p.drawPolygon(QtGui.QPolygonF([QtCore.QPointF(49, 36), QtCore.QPointF(56.5, 41), QtCore.QPointF(48.5, 45)]))
        elif kind == "error":
            p.drawLine(QtCore.QPointF(47, 39.5), QtCore.QPointF(47, 48.5))
            p.drawPoint(QtCore.QPointF(47, 55))
        elif kind == "stopped":
            p.drawLine(QtCore.QPointF(43, 41.5), QtCore.QPointF(43, 52.5))
            p.drawLine(QtCore.QPointF(51, 41.5), QtCore.QPointF(51, 52.5))
        else:  # offline
            p.drawLine(QtCore.QPointF(40.5, 47), QtCore.QPointF(53.5, 47))
    p.end()
    return pm


def text_window(QtWidgets, title: str, read_text, extra: tuple | None = None):
    """Finestrella di sola lettura con «Aggiorna» e, se serve, un pulsante in più (etichetta, funzione)."""
    win = QtWidgets.QDialog()
    win.setWindowTitle(title)
    win.resize(760, 420)
    view = QtWidgets.QPlainTextEdit()
    view.setReadOnly(True)

    def load() -> None:
        view.setPlainText(read_text())
        view.verticalScrollBar().setValue(view.verticalScrollBar().maximum())

    row = QtWidgets.QHBoxLayout()
    row.addStretch(1)
    for label, action in ([extra] if extra else []) + [(_('Refresh'), lambda: None), (_('Close'), win.close)]:
        button = QtWidgets.QPushButton(label)
        button.clicked.connect(lambda _checked=False, fn=action: (fn(), load()))
        row.addWidget(button)
    layout = QtWidgets.QVBoxLayout(win)
    layout.addWidget(view)
    layout.addLayout(row)
    load()
    win.show()
    return win


def build_tray_menu(QtCore, QtGui, QtWidgets, cfg: dict, on_quit):
    """Menu dell'icona. Ritorna (menu, refresh, open_folder); refresh() riallinea le voci allo stato
    attuale e ritorna (tipo, testo) per icona e suggerimento."""
    local = Path(os.path.expanduser(cfg["local"])).absolute()
    script = Path(__file__).resolve()
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    menu = QtWidgets.QMenu()
    windows: list[object] = []  # tiene vive le finestre aperte

    def item(label: str, icon: str, action):
        entry = menu.addAction(QtGui.QIcon.fromTheme(icon), label)
        entry.triggered.connect(lambda _checked=False: action())
        return entry

    def open_folder() -> None:
        QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(str(local)))

    def sync_now() -> None:
        if not poke_daemon():  # servizio fermo: una sincronizzazione singola
            subprocess.Popen([sys.executable, str(script), "sync"], **quiet)

    def toggle_pause() -> None:
        if PAUSE_FILE.exists():
            PAUSE_FILE.unlink(missing_ok=True)
        else:
            PAUSE_FILE.touch()
        poke_daemon()
        refresh()

    status_item = menu.addAction("")
    hint_item = menu.addAction("")
    status_item.setEnabled(False)
    hint_item.setEnabled(False)
    menu.addSeparator()
    item(_('Open iCloud Drive folder'), "folder-open", open_folder)
    sync_item = item(_('Sync now'), "view-refresh", sync_now)
    pause_item = item("", "media-playback-pause", toggle_pause)
    menu.addSeparator()
    skipped_item = item("", "dialog-warning", lambda: windows.append(text_window(
        QtWidgets, _('Skipped items — iCloud Drive'), skipped_text, (_('Retry all'), retry_skipped))))
    item(_('Activity log…'), "text-x-log", lambda: windows.append(text_window(
        QtWidgets, _('Activity log — iCloud Drive'), lambda: log_text(300))))
    login_item = item("", "dialog-password", lambda: subprocess.Popen(
        [sys.executable, str(script), "login", "--gui"], **quiet))
    menu.addSeparator()
    item(_('Close tray icon'), "application-exit", on_quit)

    def refresh() -> tuple[str, str]:
        kind, text, hint = tray_state()
        st = load_state()
        paused = PAUSE_FILE.exists()
        status_item.setText(text)
        hint_item.setText(hint)
        hint_item.setVisible(bool(hint))
        sync_item.setEnabled(kind != "sync" and not paused)
        pause_item.setText(_('Resume sync') if paused else _('Pause'))
        skipped_item.setText(_('Skipped items ({v1})…').format(v1=len(st.get('skipped', {}))))
        skipped_item.setVisible(bool(st.get("skipped")))
        days = login_days_left(st)
        login_item.setText(_('Renew Apple sign-in…') if days is None
                           else _('Renew Apple sign-in… ({v1} days left)').format(v1=max(days, 0)))
        return kind, text

    menu.items = {"status": status_item, "hint": hint_item, "sync": sync_item, "pause": pause_item,
                  "skipped": skipped_item, "login": login_item}
    return menu, refresh, open_folder


def cmd_tray(cfg: dict, _args) -> int:
    try:
        from PyQt6 import QtCore, QtGui, QtWidgets
    except ImportError:
        sys.exit(_('The tray icon needs PyQt6:  sudo apt install python3-pyqt6'))
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = TRAY_LOCK.open("a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        say(_('The tray icon is already running.'))
        return 0
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()

    app = QtWidgets.QApplication([APP])
    app.setApplicationName(APP)
    app.setApplicationDisplayName("iCloud Drive")
    app.setDesktopFileName(APP)
    app.setQuitOnLastWindowClosed(False)

    tray = QtWidgets.QSystemTrayIcon()
    menu, menu_refresh, open_folder = build_tray_menu(QtCore, QtGui, QtWidgets, cfg, app.quit)

    def on_click(reason) -> None:
        if reason == QtWidgets.QSystemTrayIcon.ActivationReason.Trigger:
            open_folder()

    tray.activated.connect(on_click)
    tray.setContextMenu(menu)
    icons: dict[str, object] = {}
    shown: list[object] = [None]

    def refresh() -> None:
        kind, text = menu_refresh()
        if (kind, text) == shown[0]:
            return
        shown[0] = (kind, text)
        if kind not in icons:
            icons[kind] = QtGui.QIcon(tray_pixmap(QtCore, QtGui, kind))
        tray.setIcon(icons[kind])
        tray.setToolTip(f"iCloud Drive — {text}")

    refresh()
    tray.show()
    timer = QtCore.QTimer()
    timer.timeout.connect(refresh)  # il timer fa anche girare l'interprete, così i segnali vengono serviti
    timer.start(2000)
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    rc = app.exec()
    tray.hide()
    return rc


def cmd_restart(_cfg: dict, _args) -> int:
    return systemctl("restart", UNIT_NAME).returncode


def service_state() -> str:
    if not shutil.which("systemctl"):
        return _('systemd not available')
    s = systemctl("is-active", UNIT_NAME, quiet=True).stdout.strip()
    return {"active": _('active'), "inactive": _('stopped'), "failed": _('failed')}.get(s, s or _('not installed'))


def cmd_status(cfg: dict, args) -> int:
    st = load_state()
    status = st.get("status")
    if args.json:
        say(json.dumps({**st, "service": service_state(), "local": cfg["local"], "remote": cfg["remote"]}, indent=1))
        return 0 if status == "ok" else 1
    say(f"{cfg['local']}  ⇄  {cfg['remote']}")
    line = _(STATUS_TEXT.get(status, N_('never synced')))
    if status == "ok":
        line += f" ({ago(st.get('last_success'))}, {summarize(st.get('last_counts', {}))})"
    say(_('  State:      {line}').format(line=line))
    if status and status not in ("ok", "busy", "offline"):
        say(f"              {st.get('message', '')}")
        if STATUS_HINT.get(status):
            say(f"              → {_(STATUS_HINT[status])}")
        say(_('  Last ok:    {v1}').format(v1=ago(st.get('last_success'))))
    if st.get("skipped"):
        say(_('  Skipped:    {v1} items that cannot be downloaded from iCloud → {app} skipped').format(v1=len(st['skipped']), app=APP))
    say(_('  Service:    {v1}').format(v1=service_state()) + (_(' — PAUSED ({app} resume)').format(app=APP) if PAUSE_FILE.exists() else ""))
    if st.get("last_login"):
        left = TRUST_DAYS - (time.time() - st["last_login"]) / 86400
        say(_('  Sign-in:    ') + (_('valid for about {v1} more days').format(v1=int(left)) if left > 0 else _('probably expired → {app} login').format(app=APP)))
    return 0 if status == "ok" else 1


def skipped_text() -> str:
    skipped = load_state().get("skipped", {})
    if not skipped:
        return _('No skipped items: everything in iCloud Drive is being synced.')
    lines = [_('Items that rclone cannot download from iCloud and that are therefore NOT synced:')]
    lines += [f"  {path}\n      {_(why)}" for path, why in sorted(skipped.items())]
    return "\n".join(lines)


def retry_skipped() -> int:
    """Rimuove le esclusioni automatiche: verranno riprovate alla prossima sincronizzazione."""
    st = load_state()
    count = len(st.get("skipped", {}))
    if count:
        st["skipped"] = {}
        save_state(st)
        poke_daemon()
    return count


def cmd_skipped(_cfg: dict, args) -> int:
    if args.retry and load_state().get("skipped"):
        say(_('{v1} exclusions removed: they will be retried at the next sync.').format(v1=retry_skipped()))
        return 0
    say(skipped_text())
    if load_state().get("skipped"):
        say(_('\nTo retry them (e.g. after an rclone update):  {app} skipped --retry').format(app=APP))
    return 0


def log_text(lines: int, path: Path = LOG_FILE) -> str:
    if not path.exists():
        return _('No log yet.')
    return "\n".join(path.read_text(errors="replace").splitlines()[-lines:])


def cmd_log(_cfg: dict, args) -> int:
    say(log_text(args.lines, ERR_LOG if args.error else LOG_FILE))
    return 0


def cmd_install_rclone(_cfg: dict, _args) -> int:
    install_rclone()
    return 0


def cmd_doctor(cfg: dict, _args) -> int:
    bad = 0

    def check(ok: bool, label: str, detail: str = "") -> None:
        nonlocal bad
        bad += not ok
        say(f"  {'✓' if ok else '✗'} {label}" + (f" — {detail}" if detail else ""))

    rclone = find_rclone(cfg)
    ver = rclone_version(rclone) if rclone else (0,)
    check(bool(rclone) and ver[:2] >= MIN_RCLONE, "rclone",
          f"{rclone} v{'.'.join(map(str, ver))}" if rclone else _('missing → {app} install-rclone').format(app=APP))
    if not rclone or ver[:2] < MIN_RCLONE:
        return 1
    eng = Engine(cfg)
    name = remote_name(eng.remote)
    if name:
        remotes = eng.run(["listremotes"]).stdout.split()
        check(f"{name}:" in remotes, _('remote "{name}" configured').format(name=name), "" if f"{name}:" in remotes else f"→ {APP} login")
    check(eng.online(), _('network'), cfg["connectivity_host"] or _('check disabled'))
    t0 = time.time()
    ok, err = eng.probe()
    check(ok, _('iCloud Drive answers'), f"{time.time() - t0:.1f}s" if ok else f"{err} → {APP} login")
    check(eng.local.is_dir(), _('local folder'), str(eng.local))
    if cfg["check_access"] and ok:
        lf = (eng.local / CHECK_FILE).exists()
        p = eng.run(["lsf", remote_join(eng.remote, CHECK_FILE)])
        rf = p.returncode == 0 and bool(p.stdout.strip())
        check(lf and rf, _('check file {check_file}').format(check_file=CHECK_FILE),
              _('present on both sides') if lf and rf else _('local: {v1}, iCloud: {v2} → {app} resync').format(v1=_('yes') if lf else _('no'), v2=_('yes') if rf else _('no'), app=APP))
    if eng.local.is_dir():
        ndirs = sum(1 for _ in os.walk(eng.local))
        try:
            limit = int(Path("/proc/sys/fs/inotify/max_user_watches").read_text())
        except (OSError, ValueError):
            limit = 0
        check(not limit or ndirs < limit * 0.8, "inotify", _('{ndirs} folders, limit {limit}').format(ndirs=ndirs, limit=limit))
    svc = service_state()
    check(svc == _('active'), _('service'), svc if svc == _('active') else f"{svc} → {APP} enable")
    st = load_state()
    check(st.get("status") == "ok", _('last sync'),
          f"{_(STATUS_TEXT.get(st.get('status'), N_('never run')))} ({ago(st.get('last_attempt'))})")
    return 1 if bad else 0


def cmd_setup(_cfg, _args) -> int:
    say(_('=== {app}: guided setup ===').format(app=APP))
    say(_('Free software (MIT license), provided without any warranty: keep a backup of your important files.\n'))
    cfg = load_config(required=False)

    rclone = find_rclone(cfg)
    if not rclone or rclone_version(rclone)[:2] < MIN_RCLONE:
        say(_('rclone (>= 1.69) is not installed: it is the engine that talks to iCloud.'))
        if not confirm(_('Download the official binary from rclone.org into ~/.local/bin (with checksum verification)?')):
            say(_('Install it (e.g. sudo apt install rclone) and run again:  {app} setup').format(app=APP))
            return 1
        install_rclone()

    if not CONFIG_FILE.exists():
        name = ask(_('Name of the rclone remote'), "icloud")
        cfg["remote"] = f"{name}:"
        cfg["local"] = ask(_('Local folder'), DEFAULTS["local"])
    write_config(cfg)
    say(_('✓ Configuration: {config_file}\n').format(config_file=CONFIG_FILE))

    ns = argparse.Namespace(new_password=False, reset=False, apple_id=None)
    eng = Engine(cfg)
    ok = False
    if remote_name(cfg["remote"]) and f"{remote_name(cfg['remote'])}:" in eng.run(["listremotes"]).stdout.split():
        ok, _err = eng.probe()
    if remote_name(cfg["remote"]) and not ok:
        if cmd_login(cfg, ns) != 0:
            return 1

    say(_('\nFirst sync: it merges both sides without deleting anything; when two files share a name the newer one wins.'))
    say(_('It can take a while if iCloud Drive holds many files.\n'))
    res = eng.sync(interactive=True, manual=True)
    if finish(res) != 0:
        say(_('\nFix the problem and run again:  {app} setup').format(app=APP))
        return 1
    say("")
    if shutil.which("systemctl") and confirm(_('Turn on automatic background sync?')):
        cmd_enable(cfg, None)
    say(_('\nDone. Useful commands:  {app} status  ·  {app} sync  ·  {app} log  ·  {app} doctor').format(app=APP))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog=APP, description=_('Two-way iCloud Drive synchronization for Linux (engine: rclone bisync).'),
        epilog=_('Free software under the MIT license, provided WITHOUT ANY WARRANTY. Independent project, not affiliated with Apple. {homepage}').format(homepage=HOMEPAGE))
    ap.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = ap.add_subparsers(dest="cmd", metavar=_('command'))

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_, description=help_)
        p.set_defaults(fn=fn)
        return p

    add("setup", cmd_setup, _('guided setup: rclone, Apple sign-in, first sync, service'))
    add("status", cmd_status, _('show the sync state')).add_argument("--json", action="store_true")
    p = add("sync", cmd_sync, _('sync now'))
    p.add_argument("--dry-run", action="store_true", help=_('show what would be done without changing anything'))
    p.add_argument("--force", action="store_true", help=_('also allow a large number of deletions'))
    p = add("resync", cmd_resync, _('realign both sides from scratch (deletes nothing)'))
    p.add_argument("--prefer", choices=["newer", "local", "icloud"], default="newer", help=_('who wins when a file differs (default: the newer one)'))
    p.add_argument("--dry-run", action="store_true")
    p = add("login", cmd_login, _('sign in to the Apple ID again: needed about every 30 days'))
    p.add_argument("--new-password", action="store_true", help=_('enter Apple ID and password again'))
    p.add_argument("--reset", action="store_true", help=_('clear the saved cookies and token before retrying'))
    p.add_argument("--gui", action="store_true", help=_('use a window instead of the terminal'))
    add("enable", cmd_enable, _('start the background service and the tray icon, at every login'))
    add("disable", cmd_disable, _('stop the service and the tray icon'))
    add("restart", cmd_restart, _('restart the service (after changing the configuration)'))
    add("pause", cmd_pause, _('suspend automatic sync until you resume it'))
    add("resume", cmd_resume, _('resume automatic sync'))
    sub.add_parser("_notify").set_defaults(fn=cmd_notify_helper)  # interno: notifica con pulsanti
    sub.choices["_notify"].add_argument("spec")
    add("watch", cmd_watch, _('run the daemon in the foreground (used by the service)'))
    add("tray", cmd_tray, _('tray icon: state, open folder, sync now'))
    p = add("log", cmd_log, _('show the last lines of the log'))
    p.add_argument("-n", "--lines", type=int, default=40)
    p.add_argument("--error", action="store_true", help=_('full rclone log of the last failed sync'))
    p = add("skipped", cmd_skipped, _('list the items iCloud will not let rclone download'))
    p.add_argument("--retry", action="store_true", help=_('remove the exclusions and try again'))
    add("doctor", cmd_doctor, _('full diagnostic'))
    add("install-rclone", cmd_install_rclone, _('install or update rclone in ~/.local/bin'))

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        return 0
    cfg = None if args.cmd in ("setup", "install-rclone", "_notify") else load_config()
    try:
        rc = args.fn(cfg, args)
    except KeyboardInterrupt:
        say(_('\nInterrupted.'))
        return 130
    except BrokenPipeError:  # es. `icloud-sync log | head`: chi leggeva ha chiuso, non è un errore
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0
    if rc == 0 and args.cmd in ("sync", "resync") and not args.dry_run:
        poke_daemon()
    return rc


