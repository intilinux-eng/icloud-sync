def service_state() -> str:
    if not shutil.which("systemctl"):
        return "systemd non disponibile"
    s = systemctl("is-active", UNIT_NAME, quiet=True).stdout.strip()
    return {"active": "attivo", "inactive": "fermo", "failed": "fallito"}.get(s, s or "non installato")


def cmd_status(cfg: dict, args) -> int:
    st = load_state()
    status = st.get("status")
    if args.json:
        say(json.dumps({**st, "service": service_state(), "local": cfg["local"], "remote": cfg["remote"]}, indent=1))
        return 0 if status == "ok" else 1
    say(f"{cfg['local']}  ⇄  {cfg['remote']}")
    line = STATUS_TEXT.get(status, "mai sincronizzato")
    if status == "ok":
        line += f" ({ago(st.get('last_success'))}, {summarize(st.get('last_counts', {}))})"
    say(f"  Stato:      {line}")
    if status and status not in ("ok", "busy", "offline"):
        say(f"              {st.get('message', '')}")
        if STATUS_HINT.get(status):
            say(f"              → {STATUS_HINT[status]}")
        say(f"  Ultima ok:  {ago(st.get('last_success'))}")
    if st.get("skipped"):
        say(f"  Esclusi:    {len(st['skipped'])} elementi non scaricabili da iCloud → {APP} skipped")
    say(f"  Servizio:   {service_state()}")
    if st.get("last_login"):
        left = TRUST_DAYS - (time.time() - st["last_login"]) / 86400
        say("  Login:      " + (f"valido ancora ~{int(left)} giorni" if left > 0 else f"probabilmente scaduto → {APP} login"))
    return 0 if status == "ok" else 1


def cmd_skipped(_cfg: dict, args) -> int:
    st = load_state()
    skipped = st.get("skipped", {})
    if not skipped:
        say("Nessun elemento escluso: tutto ciò che è in iCloud Drive viene sincronizzato.")
        return 0
    if args.retry:
        st["skipped"] = {}
        save_state(st)
        say(f"{len(skipped)} esclusioni rimosse: verranno riprovate alla prossima sincronizzazione.")
        poke_daemon()
        return 0
    say("Elementi che rclone non riesce a scaricare da iCloud e che quindi NON vengono sincronizzati:")
    for path, why in sorted(skipped.items()):
        say(f"  {path}\n      {why}")
    say(f"\nPer riprovarli (es. dopo un aggiornamento di rclone):  {APP} skipped --retry")
    return 0


