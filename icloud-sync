# ---------------------------------------------------------------- lingua

def detect_language() -> str:
    """Lingua dei messaggi: "it" se l'ambiente chiede l'italiano, altrimenti inglese.
    Stesso ordine di gettext: LANGUAGE, LC_ALL, LC_MESSAGES, LANG."""
    for var in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            return "it" if value.split(":")[0].lower().startswith("it") else "en"
    return "en"


